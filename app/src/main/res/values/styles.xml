<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PremiumDialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#6E83FF</item>
        <item name="android:textColorPrimary">#EEF2F9</item>
        <item name="android:textColorSecondary">#AAB4C8</item>
        <item name="android:windowBackground">#171D2A</item>
        <item name="android:navigationBarColor">#080A0E</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#090B10</item>
        <item name="android:navigationBarColor">#080A0E</item>
        <item name="android:statusBarColor">#090B10</item>
        <item name="android:colorAccent">#6E83FF</item>
        <item name="android:alertDialogTheme">@style/PremiumDialogTheme</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">false</item>
        <item name="android:windowContentTransitions">true</item>
    </style>
</resources>
