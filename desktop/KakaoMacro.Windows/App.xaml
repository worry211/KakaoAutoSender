<Application x:Class="KakaoMacro.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0F1115" />
        <SolidColorBrush x:Key="Panel" Color="#171A20" />
        <SolidColorBrush x:Key="Panel2" Color="#20242C" />
        <SolidColorBrush x:Key="Accent" Color="#FEE500" />
        <SolidColorBrush x:Key="Text" Color="#F4F5F7" />
        <SolidColorBrush x:Key="Muted" Color="#9AA3B2" />
        <SolidColorBrush x:Key="Danger" Color="#FF6B6B" />
        <Style TargetType="Window"><Setter Property="Background" Value="{StaticResource Bg}"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="TextBox"><Setter Property="Background" Value="#11141A"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#343A46"/><Setter Property="Padding" Value="10,7"/><Setter Property="CaretBrush" Value="White"/></Style>
        <Style TargetType="ComboBox"><Setter Property="Background" Value="#11141A"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="BorderBrush" Value="#343A46"/><Setter Property="Padding" Value="8,5"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{StaticResource Text}"/></Style>
        <Style TargetType="Button"><Setter Property="Background" Value="#2A303A"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/></Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#111111"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#53282D"/><Setter Property="Foreground" Value="#FFD6D9"/></Style>
    </Application.Resources>
</Application>
