<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1520" Height="940" MinWidth="1220" MinHeight="780"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="64"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top product bar -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="28" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#655C12" BorderThickness="1"
                            CornerRadius="8" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#374486" BorderThickness="1"
                            CornerRadius="8" Padding="8,3" Margin="6,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="v1.4" Foreground="#CDD2FF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="상태를 불러오는 중입니다."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="14,8"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 시작" Click="StartAll_Click" Padding="18,9"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <!-- License/service strip -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource SuccessSoft}" BorderBrush="#2C6246"
                        BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="13"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버에 연결하고 있습니다."
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="280" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 라이선스 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="인증" Click="Activate_Click" Padding="16,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Room sidebar -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="자동전송 방" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 방 연결" Click="PairCurrent_Click" Padding="13,8" Margin="3,0,0,0"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#11161D" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,11,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Width="8" Height="8" Background="{StaticResource Brand}" CornerRadius="4" VerticalAlignment="Center" Margin="1,0,9,0"/>
                            <TextBlock x:Name="PairingStatusText" Grid.Column="1"
                                       Text="카카오톡 입력칸 클릭 → Ctrl+Shift+F8"
                                       Foreground="#C9CFD9" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,9">
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름 또는 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="상태 필터">
                                <ComboBoxItem Content="전체"/>
                                <ComboBoxItem Content="실행 중"/>
                                <ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/>
                                <ComboBoxItem Content="연결 필요"/>
                                <ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬">
                                <ComboBoxItem Content="상태 우선"/>
                                <ComboBoxItem Content="다음 전송"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="11" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="9"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#9EA8B8" FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Panel3}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="9" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="7"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource GhostButton}" Content="전체 선택" Click="SelectAllRooms_Click" Margin="0"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <TabControl>
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <!-- persistent action rail -->
                            <Border DockPanel.Dock="Bottom" Background="#0B1017" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="11" Margin="0,10,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#C9D0DD" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SaveRoomButton" Content="저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                        <Button Content="중단" Click="StopSelected_Click"/>
                                        <Button Style="{StaticResource SuccessButton}" Content="시작" Click="StartSelected_Click"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="TestSend_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,7">
                                <StackPanel Margin="2,2,4,10">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="방 설정" FontSize="23" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSoft}" BorderBrush="#2D6346" BorderThickness="1"
                                                CornerRadius="9" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="변경 즉시 저장" Foreground="#A9EFCB" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.45*"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="보낼 메시지" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="이 방에 실제로 전송될 내용" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="최대 4,000자" Foreground="{StaticResource Muted2}" FontSize="9" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBox x:Name="MessageEditor" Height="190" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed" Margin="0,11,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="방 정보" FontSize="13" FontWeight="SemiBold"/>
                                                        <TextBlock Text="이름과 사용 여부" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="자동전송 사용" IsChecked="True"
                                                              Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                                </Grid>
                                                <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,13,0,5"/>
                                                <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                                <Border Background="#0D1219" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                        CornerRadius="9" Padding="10" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="전송 안전" Foreground="#D6DCE6" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="방 연결이 달라지거나 카카오톡이 재시작되면 자동으로 중지합니다."
                                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="전송 일정" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="간격 반복 또는 매일 지정 시각 중 하나를 선택합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.1*"/>
                                                    <ColumnDefinition Width="10"/>
                                                    <ColumnDefinition Width="0.8*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="방식" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                    <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectedIndex="0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="간격 반복"/>
                                                        <ComboBoxItem Content="매일 지정 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="하루 최대 전송 · 0 = 무제한" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IntervalPanel" Margin="0,12,0,0">
                                                <TextBlock Text="반복 간격" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" Text="60" TextChanged="SingleEditor_Changed"/>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="TimesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                <TextBox x:Name="TimesBox" Margin="0,5,0,0" Text="09:00" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#584A20" BorderThickness="1" CornerRadius="10" Padding="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="사진 전송 잠금" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="10" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="사진이 설정된 방은 검증이 끝날 때까지 텍스트만 대신 보내지 않고 전체 전송을 차단합니다."
                                                       Foreground="#C6B98F" FontSize="9"/>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="여러 방 작업">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0B1017" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="11" Padding="11" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="체크한 항목만 선택된 방에 적용됩니다." Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="UndoBulkButton" Style="{StaticResource GhostButton}" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="선택한 방에 적용" Click="ApplyBulk_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,7">
                                <StackPanel Margin="2,2,4,10">
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="여러 방 작업" FontSize="23" FontWeight="Bold"/>
                                            <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SuccessButton}" Content="사용 켜기" Click="EnableSelected_Click" Margin="0"/>
                                        <Button Grid.Column="2" Content="사용 끄기" Click="DisableSelected_Click" Margin="0"/>
                                        <Button Grid.Column="4" Style="{StaticResource SuccessButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0"/>
                                        <Button Grid.Column="6" Content="선택 중단" Click="StopSelected_Click" Margin="0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="체크했을 때만 메시지를 바꿉니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,8"/>
                                                <TextBox x:Name="BulkMessageEditor" Height="130" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyScheduleCheck" Content="전송 일정 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="체크했을 때만 일정이 바뀝니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,8"/>
                                                <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="간격 반복"/>
                                                    <ComboBoxItem Content="매일 지정 시각"/>
                                                </ComboBox>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="BulkIntervalBox" Text="60" ToolTip="간격 반복일 때 분 단위"/>
                                                    <TextBox x:Name="BulkTimesBox" Grid.Column="2" Text="09:00" ToolTip="지정 시각 예: 09:00, 13:30"/>
                                                </Grid>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="0 = 제한 없음" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,8"/>
                                                <TextBox x:Name="BulkDailyLimitBox" Text="8"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택한 방의 사용 상태를 일괄 변경합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,10"/>
                                                <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="#0D1219" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="전송·삭제는 설정 변경과 분리해 실수 가능성을 줄였습니다." Foreground="{StaticResource Muted}" FontSize="9" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                                                <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="RemoveSelected_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="운영 · 진단">
                        <Grid Margin="2,2,4,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="운영 · 진단" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,13"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="1.1*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="연결 상태" FontWeight="SemiBold"/>
                                        <TextBlock Text="카카오톡 재시작·창 변경·대상 불일치를 다시 검증합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,9"/>
                                        <WrapPanel>
                                            <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                            <Button Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="백그라운드 운영" FontWeight="SemiBold"/>
                                        <TextBlock Text="창을 닫아도 트레이에서 자동전송을 계속 유지할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼을 누르면 트레이로 숨기기" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#0D1219" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="설정 보호" Foreground="#D6DCE6" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="자동 저장 + 마지막 정상 백업 + 손상본 보존으로 로컬 설정을 보호합니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="설정 폴더" Click="OpenSettingsFolder_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="10" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
