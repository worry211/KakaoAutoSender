<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1440" Height="900" MinWidth="1180" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="66"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="29" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#6A620B" BorderThickness="1"
                            CornerRadius="9" Padding="8,3" Margin="11,3,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="자동전송 상태를 준비하고 있습니다."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="13,8"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 시작" Click="StartAll_Click" Padding="18,9"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource AccentSoft}" BorderBrush="#3D4A99"
                        BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
                    <TextBlock Text="✓" Foreground="#C8CEFF" FontWeight="Bold" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다."
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="275" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="350"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="방 목록" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 방 연결" Click="PairCurrent_Click" Padding="14,8"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="#344080" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,11,0,10">
                        <TextBlock x:Name="PairingStatusText"
                                   Text="카카오톡 입력칸을 클릭한 뒤 Ctrl+Shift+F8로 연결할 수 있습니다."
                                   Foreground="#C7CCFF" FontSize="11"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름이나 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="모든 방"/><ComboBoxItem Content="실행 중"/><ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/><ComboBoxItem Content="연결 필요"/><ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬 기준">
                                <ComboBoxItem Content="상태 우선"/><ComboBoxItem Content="다음 전송"/><ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CompactButton}" Content="현재 목록 전체 선택" Click="SelectAllRooms_Click" Margin="0"/>
                            <Button Grid.Column="2" Style="{StaticResource CompactButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0"/>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="12" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="11"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="11"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#ADB6C5" FontSize="11" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Panel3}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="9" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="11" FontWeight="SemiBold" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="9" Margin="0,10,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SuccessButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Content="선택 중단" Click="StopSelected_Click" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="1회 전송" Click="SendSelectedNow_Click" Margin="0"/>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Danger}" Content="선택한 방 삭제" Click="RemoveSelected_Click" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <TabControl>
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="11,9" Margin="0,9,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#C7CCFF" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="입력한 변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SaveRoomButton" Content="설정 저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="이 방에 1회 전송" Click="TestSend_Click" Padding="17,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                                <StackPanel Margin="2,2,5,12">
                                    <Grid Margin="0,0,0,17">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="방 자동전송 설정" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSoft}" BorderBrush="#2E6548" BorderThickness="1"
                                                CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="변경사항 자동 저장" Foreground="#A6EFC9" FontSize="11" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1.7*"/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="방 이름" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="목록에서 알아보기 쉬운 이름" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,8"/>
                                                <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="보낼 메시지" FontSize="12" FontWeight="SemiBold"/>
                                                <TextBlock Text="실제로 카카오톡에 전송될 내용" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,8"/>
                                                <TextBox x:Name="MessageEditor" Height="112" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="언제 보낼까요?" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="간격 반복 또는 하루 지정 시각 중 하나를 선택합니다."
                                                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="이 방 사용" IsChecked="True" Margin="12,0,0,0"
                                                          Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                            </Grid>
                                            <Grid Margin="0,13,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="전송 방식" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="0을 입력하면 제한 없음"/>
                                                    <TextBlock Text="0 = 제한 없음" Foreground="{StaticResource Muted2}" FontSize="9" Margin="2,3,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IntervalPanel" Margin="0,12,0,0">
                                                <TextBlock Text="반복 간격" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" TextChanged="SingleEditor_Changed" ToolTip="분 단위"/>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="TimesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <TextBox x:Name="TimesBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#5B4C22" BorderThickness="1" CornerRadius="11" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="사진 자동전송은 아직 잠겨 있습니다" Foreground="{StaticResource Warning}" FontWeight="SemiBold"/>
                                            <TextBlock Text="사진이 설정된 방은 검증이 끝날 때까지 텍스트만 보내는 대신 전송 전체를 안전하게 차단합니다."
                                                       Foreground="#C9B98D" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="여러 방 수정">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                            <StackPanel Margin="2,2,5,12">
                                <TextBlock Text="여러 방 한 번에 수정" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,17"/>

                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="11"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyMessageCheck" Content="메시지 바꾸기" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크했을 때만 선택한 방의 메시지가 바뀝니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <TextBox x:Name="BulkMessageEditor" Height="108" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyScheduleCheck" Content="스케줄 바꾸기" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크했을 때만 전송 시간이 바뀝니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                            </ComboBox>
                                            <TextBox x:Name="BulkIntervalBox" Text="60" Margin="0,7,0,0" ToolTip="간격 반복일 때 분 단위"/>
                                            <WrapPanel Margin="0,5,0,0">
                                                <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                            </WrapPanel>
                                            <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,6,0,0" ToolTip="지정 시각일 때 예: 09:00, 13:30"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="11"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 바꾸기" FontWeight="SemiBold"/>
                                            <TextBlock Text="0을 입력하면 제한 없음" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <TextBox x:Name="BulkDailyLimitBox" Text="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 바꾸기" FontWeight="SemiBold"/>
                                            <TextBlock Text="선택한 방을 한 번에 켜거나 끕니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                            <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="체크한 항목만 적용됩니다" FontWeight="SemiBold"/>
                                            <TextBlock Text="실수로 다른 설정이 덮어써지지 않도록 선택한 항목만 변경합니다."
                                                       Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                            <Button x:Name="UndoBulkButton" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="선택 항목 적용" Click="ApplyBulk_Click" Padding="17,9"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="빠른 작업" FontWeight="SemiBold" FontSize="12" Margin="0,17,0,6"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource SuccessButton}" Content="사용 켜기" Click="EnableSelected_Click"/>
                                    <Button Content="사용 끄기" Click="DisableSelected_Click"/>
                                    <Button Content="선택 시작" Click="StartSelected_Click"/>
                                    <Button Content="선택 중단" Click="StopSelected_Click"/>
                                    <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="상태 · 도구">
                        <Grid Margin="2,2,5,7">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 상태" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,15"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="연결 상태 점검" FontWeight="SemiBold"/>
                                        <TextBlock Text="카카오톡 재시작이나 연결 끊김을 확인합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <WrapPanel>
                                            <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                            <Button Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="앱 동작" FontWeight="SemiBold"/>
                                        <TextBlock Text="창을 닫아도 트레이에서 자동전송을 유지할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼은 트레이로 숨김" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="설정은 자동 저장되며 로컬 PC에만 보관됩니다." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="설정 폴더 열기" Click="OpenSettingsFolder_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>