<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1500" Height="900" MinWidth="1180" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="27" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#655C12" BorderThickness="1"
                            CornerRadius="8" Padding="7,3" Margin="10,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#3D4E91" BorderThickness="1"
                            CornerRadius="8" Padding="7,3" Margin="6,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="v1.5" Foreground="#D7DCFF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="상태를 불러오는 중입니다."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="13,8" Margin="0,0,8,0"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="17,8" Margin="0,0,8,0"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="17,8"/>
            </StackPanel>
        </Grid>

        <!-- License strip -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="4" Background="{StaticResource Accent}" CornerRadius="2"/>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버에 연결하고 있습니다."
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="280" Margin="0,0,8,0" ToolTip="판매자에게 받은 KM-... 라이선스 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click" Padding="15,8"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="350"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Room navigator: find/select only -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="자동전송 방" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="＋ 새 방 연결" Click="PairCurrent_Click" Padding="12,8"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#0C121B" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,11,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Width="7" Height="7" Background="{StaticResource Brand}" CornerRadius="4" VerticalAlignment="Center" Margin="1,0,9,0"/>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="방 연결" Foreground="#D5DBE5" FontSize="9" FontWeight="SemiBold"/>
                                <TextBlock x:Name="PairingStatusText" Text="카카오톡 입력칸 클릭 → Ctrl+Shift+F8"
                                           Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="방 검색" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름 또는 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="상태 필터">
                                <ComboBoxItem Content="전체"/>
                                <ComboBoxItem Content="실행 중"/>
                                <ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/>
                                <ComboBoxItem Content="연결 필요"/>
                                <ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬">
                                <ComboBoxItem Content="상태 우선"/>
                                <ComboBoxItem Content="다음 전송"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="12" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="9" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="9"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="9"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#8E9BB0" FontSize="9" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#101722" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="6,2" Margin="9,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="9" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="4" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButton}" Content="현재 목록 전체 선택" Click="SelectAllRooms_Click" Padding="10,7"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="선택 해제" Click="ClearSelection_Click" Padding="10,7"/>
                    </Grid>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="17">
                <TabControl>
                    <!-- Single room editor -->
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0B1119" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="11" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#D6DCE6" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="유효한 변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource QuietButton}" Content="일시정지" Click="StopSelected_Click" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource SuccessButton}" Content="자동전송 시작" Click="StartSelected_Click" Margin="0,0,7,0"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="TestSend_Click" Padding="17,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,4">
                                <StackPanel Margin="1,1,4,8">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="선택한 방 설정" FontSize="23" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#12261E" BorderBrush="#2C5E46" BorderThickness="1"
                                                CornerRadius="9" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="자동 저장 활성" Foreground="#A3E9C5" FontSize="9" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.45*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="보낼 메시지" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="이 방에 실제로 전송될 내용을 입력하세요." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="최대 4,000자" Foreground="{StaticResource Muted2}" FontSize="9" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBox x:Name="MessageEditor" Height="190" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed" Margin="0,11,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="방 정보" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="표시 이름과 이 방의 자동전송 사용 여부" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="사용" IsChecked="True"
                                                              Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                                </Grid>
                                                <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,16,0,5"/>
                                                <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                                <Border Background="#0D141D" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                        CornerRadius="9" Padding="11" Margin="0,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="대상 보호" Foreground="#D6DCE6" FontSize="10" FontWeight="SemiBold"/>
                                                        <TextBlock Text="카카오 재시작·창 변경·대상 불일치가 감지되면 이 방은 자동 중지됩니다."
                                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <StackPanel Margin="0,0,0,11">
                                                <TextBlock Text="전송 일정" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="반복 간격 또는 매일 지정 시각 중 하나를 선택합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                            </StackPanel>

                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="전송 방식" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                    <ComboBox x:Name="ScheduleModeBox" SelectedIndex="0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="간격 반복"/>
                                                        <ComboBoxItem Content="매일 지정 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                    <TextBox x:Name="DailyLimitBox" TextChanged="SingleEditor_Changed" ToolTip="0을 입력하면 제한 없음"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IntervalPanel" Margin="0,11,0,0">
                                                <TextBlock Text="반복 간격 · 분" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" Text="60" TextChanged="SingleEditor_Changed"/>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </StackPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="TimesPanel" Margin="0,11,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                <TextBox x:Name="TimesBox" Text="09:00" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#55471E" BorderThickness="1" CornerRadius="10" Padding="11">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <TextBlock Text="사진 전송 안전 잠금" Foreground="{StaticResource Warning}" FontSize="10" FontWeight="SemiBold" Margin="0,0,12,0"/>
                                            <TextBlock Grid.Column="1" Text="사진이 설정된 방은 검증이 끝날 때까지 텍스트만 대신 보내지 않고 전송 자체를 차단합니다."
                                                       Foreground="#C7BA91" FontSize="9"/>
                                        </Grid>
                                    </Border>

                                    <Button x:Name="SaveRoomButton" Visibility="Collapsed" Click="SaveRoom_Click"/>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Bulk editor -->
                    <TabItem Header="여러 방 작업">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0B1119" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    CornerRadius="11" Padding="10" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="선택 항목만 변경" Foreground="#D6DCE6" FontSize="10" FontWeight="SemiBold"/>
                                        <TextBlock Text="체크한 설정만 선택된 방에 적용되고, 마지막 일괄 변경은 되돌릴 수 있습니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="UndoBulkButton" Style="{StaticResource GhostButton}" Content="마지막 변경 되돌리기" Click="UndoBulk_Click" IsEnabled="False" Margin="0,0,8,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="선택한 방에 적용" Click="ApplyBulk_Click" Padding="18,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,7,4">
                                <StackPanel Margin="1,1,4,8">
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="여러 방 한 번에 수정" FontSize="23" FontWeight="Bold"/>
                                            <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click" Padding="13,7"/>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="빠른 작업" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="설정값을 바꾸지 않고 선택한 방의 상태나 전송만 즉시 제어합니다."
                                                       Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,9"/>
                                            <WrapPanel>
                                                <Button Style="{StaticResource SuccessButton}" Content="사용 켜기" Click="EnableSelected_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource QuietButton}" Content="사용 끄기" Click="DisableSelected_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource SuccessButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource QuietButton}" Content="선택 중단" Click="StopSelected_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click" Margin="0,0,7,7"/>
                                                <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="RemoveSelected_Click" Margin="0,0,0,7"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="체크했을 때만 선택된 모든 방의 메시지를 바꿉니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,8"/>
                                                <TextBox x:Name="BulkMessageEditor" Height="125" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyScheduleCheck" Content="전송 일정 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="체크했을 때만 일정이 바뀝니다. 선택한 방식에 맞는 값을 사용합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,8"/>
                                                <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                    <ComboBoxItem Content="간격 반복"/>
                                                    <ComboBoxItem Content="매일 지정 시각"/>
                                                </ComboBox>
                                                <Grid Margin="0,7,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="반복 간격 · 분" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                        <TextBox x:Name="BulkIntervalBox" Text="60"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2">
                                                        <TextBlock Text="지정 시각" Foreground="{StaticResource Muted}" FontSize="9" Margin="1,0,0,5"/>
                                                        <TextBox x:Name="BulkTimesBox" Text="09:00" ToolTip="예: 09:00, 13:30"/>
                                                    </StackPanel>
                                                </Grid>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="0을 입력하면 제한 없이 사용합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,9"/>
                                                <TextBox x:Name="BulkDailyLimitBox" Text="8"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택된 방을 자동전송 대상에 포함하거나 제외합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,11"/>
                                                <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Operations -->
                    <TabItem Header="운영 · 진단">
                        <Grid Margin="1,1,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="운영 · 진단" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,13"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="카카오 연결 상태" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="재시작·창 변경·대상 불일치를 다시 검증하고 문제가 있으면 자동 중지합니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,10"/>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="선택 연결 확인" Click="ValidateSelected_Click" Margin="0,0,7,0"/>
                                            <Button Style="{StaticResource QuietButton}" Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="백그라운드 운영" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="창을 닫아도 트레이에서 자동전송을 계속 유지할 수 있습니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,11"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼을 누르면 트레이로 숨기기" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#0D141D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="설정 보호" Foreground="#D6DCE6" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock Text="자동 저장 · 마지막 정상 백업 · 손상본 보존 · 복구 로그로 방 설정을 보호합니다."
                                                   Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="설정 폴더 열기" Click="OpenSettingsFolder_Click" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#080D14" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono, Consolas" FontSize="10" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
