<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC"
        Width="1500" Height="920"
        MinWidth="1200" MinHeight="760"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="31" FontWeight="Bold"/>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource BrandSoft}" BorderBrush="#5A5312" Margin="11,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" Background="{StaticResource AccentSoft}" BorderBrush="#3D4F92" Margin="7,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="v1.6.0" Foreground="#D9DEFF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="자동전송 상태를 준비하고 있습니다." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Margin="0,0,8,0"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="18,9" Margin="0,0,8,0"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="#0D141D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="13,9" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource SuccessSoft}" BorderBrush="#2D6648" BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="285" Margin="0,0,8,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="자동전송 방" FontSize="21" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 새 방 연결" Click="PairCurrent_Click" Padding="14,8"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#101927" BorderBrush="#2B4263" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,12,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Width="24" Height="24" Background="{StaticResource AccentSoft}" BorderBrush="#415AA3" BorderThickness="1" CornerRadius="12" VerticalAlignment="Top">
                                <TextBlock Text="i" Foreground="#C9D2FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                <TextBlock Text="방 연결 상태" FontSize="11" FontWeight="SemiBold" Foreground="#D8DEEA"/>
                                <TextBlock x:Name="PairingStatusText" Text="카카오톡 입력칸을 클릭한 뒤 Ctrl+Shift+F8로 연결하세요." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,11">
                        <TextBlock Style="{StaticResource SectionLabel}" Text="방 찾기" Margin="1,0,0,5"/>
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름이나 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,8"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="모든 방"/>
                                <ComboBoxItem Content="실행 중"/>
                                <ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/>
                                <ComboBoxItem Content="연결 필요"/>
                                <ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬 기준">
                                <ComboBoxItem Content="상태 우선"/>
                                <ComboBoxItem Content="다음 전송"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="13" CornerRadius="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="10"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#AAB4C2" FontSize="10" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Top">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="오늘 " Foreground="{StaticResource Muted2}" FontSize="9"/>
                                                <TextBlock Text="{Binding TodayCount}" Foreground="#C8D0DC" FontSize="10" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Margin="0,11,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="선택 시작" Style="{StaticResource SuccessButton}" Click="StartSelected_Click"/>
                            <Button Grid.Column="2" Content="선택 중단" Click="StopSelected_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="연결 확인" Style="{StaticResource GhostButton}" Click="ValidateSelected_Click"/>
                            <Button Grid.Column="2" Content="선택 1회 전송" Style="{StaticResource PrimaryButton}" Click="SendSelectedNow_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Content="현재 목록 전체 선택" Style="{StaticResource QuietButton}" Click="SelectAllRooms_Click"/>
                            <Button Grid.Column="2" Content="선택 해제" Style="{StaticResource QuietButton}" Click="ClearSelection_Click"/>
                        </Grid>
                        <Button Content="선택한 방 삭제" Style="{StaticResource DangerButton}" Click="RemoveSelected_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <TabControl>
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0B1119" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,12,0,0">
                                <Grid MaxWidth="1000">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="11" Margin="0,0,6,0"/>
                                            <TextBlock Text="자동 저장" Foreground="#D8DEEA" FontSize="11" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="변경사항은 자동으로 저장됩니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SaveRoomButton" Content="저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button Content="시작" Style="{StaticResource SuccessButton}" Click="StartSelected_Click" Margin="0,0,7,0"/>
                                        <Button Content="중단" Click="StopSelected_Click" Margin="0,0,7,0"/>
                                        <Button Content="연결 확인" Style="{StaticResource GhostButton}" Click="ValidateSelected_Click" Margin="0,0,7,0"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="TestSend_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,7,8">
                                <StackPanel MaxWidth="1000" HorizontalAlignment="Center" Margin="2,2,7,14">
                                    <Grid Margin="0,0,0,18">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="선택한 방 설정" FontSize="26" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Style="{StaticResource Pill}" Background="{StaticResource SuccessSoft}" BorderBrush="#2D6648" VerticalAlignment="Center">
                                            <TextBlock Text="변경 즉시 자동 저장" Foreground="#ACEFCB" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="방 정보" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="앱 안에서 보일 이름과 자동전송 사용 여부를 정합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="자동전송 사용" IsChecked="True" Margin="14,0,0,0" Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                            </Grid>
                                            <TextBlock Style="{StaticResource SectionLabel}" Text="표시 이름" Margin="0,14,0,6"/>
                                            <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="보낼 메시지" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="이 방으로 자동전송할 실제 문구입니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="최대 4,000자" Foreground="{StaticResource Muted2}" FontSize="9" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBox x:Name="MessageEditor" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="전송 일정" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="간격 반복과 매일 지정 시각 중 하나만 사용합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource SectionLabel}" Text="전송 방식"/>
                                                    <ComboBox x:Name="ScheduleModeBox" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="일정 간격마다 반복"/>
                                                        <ComboBoxItem Content="매일 지정한 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Style="{StaticResource SectionLabel}" Text="하루 최대 전송"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,6,0,0" TextChanged="SingleEditor_Changed" ToolTip="0 = 제한 없음"/>
                                                </StackPanel>
                                            </Grid>
                                            <StackPanel x:Name="IntervalPanel" Margin="0,14,0,0">
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="반복 간격"/>
                                                <Grid Margin="0,6,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" Text="60" TextChanged="SingleEditor_Changed"/>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="TimesPanel" Margin="0,14,0,0" Visibility="Collapsed">
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="매일 전송 시각"/>
                                                <TextBox x:Name="TimesBox" Margin="0,6,0,0" Text="09:00" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#5C4D24" BorderThickness="1" CornerRadius="13" Padding="13">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" Background="#372D12" BorderBrush="#655522" BorderThickness="1" CornerRadius="14" VerticalAlignment="Top">
                                                <TextBlock Text="!" Foreground="{StaticResource Warning}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                                <TextBlock Text="사진 자동전송은 아직 안전 잠금 상태" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="사진이 설정된 방은 검증 전까지 텍스트만 보내는 fallback 없이 전송 전체를 차단합니다." Foreground="#CBBE95" FontSize="10" Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="여러 방 작업">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,7,8">
                            <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="2,2,7,14">
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="여러 방 한 번에 변경" FontSize="26" FontWeight="Bold"/>
                                        <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click" Margin="0,0,7,0"/>
                                        <Button x:Name="UndoBulkButton" Style="{StaticResource QuietButton}" Content="마지막 변경 되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="선택한 방 빠른 작업" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="설정을 바꾸지 않고 실행 상태나 연결만 즉시 처리합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,10"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource SuccessButton}" Content="사용 켜기" Click="EnableSelected_Click"/>
                                            <Button Grid.Column="2" Content="사용 끄기" Click="DisableSelected_Click"/>
                                            <Button Grid.Column="4" Content="선택 시작" Click="StartSelected_Click"/>
                                            <Button Grid.Column="6" Content="선택 중단" Click="StopSelected_Click"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크했을 때만 선택된 방의 메시지를 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10"/>
                                            <TextBox x:Name="BulkMessageEditor" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsChecked, ElementName=ApplyMessageCheck}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyScheduleCheck" Content="전송 일정 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크했을 때만 선택된 방의 일정 방식을 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10"/>
                                            <StackPanel IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}">
                                                <TextBlock Style="{StaticResource SectionLabel}" Text="전송 방식"/>
                                                <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0" Margin="0,6,0,0">
                                                    <ComboBoxItem Content="일정 간격마다 반복"/>
                                                    <ComboBoxItem Content="매일 지정한 시각"/>
                                                </ComboBox>
                                                <StackPanel Margin="0,12,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=BulkScheduleModeBox}" Value="1"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource SectionLabel}" Text="반복 간격 (분)"/>
                                                    <TextBox x:Name="BulkIntervalBox" Text="60" Margin="0,6,0,0" ToolTip="간격 반복일 때 분 단위"/>
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,12,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedIndex, ElementName=BulkScheduleModeBox}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Style="{StaticResource SectionLabel}" Text="매일 전송 시각"/>
                                                    <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,6,0,0" ToolTip="예: 09:00, 13:30, 21:00"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="0은 제한 없음입니다. 체크하지 않으면 기존 값을 유지합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10"/>
                                            <TextBox x:Name="BulkDailyLimitBox" Text="8" IsEnabled="{Binding IsChecked, ElementName=ApplyDailyLimitCheck}"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="선택한 방을 자동전송 사용 또는 사용 안 함으로 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,10"/>
                                            <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True" IsEnabled="{Binding IsChecked, ElementName=ApplyEnabledCheck}"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource AccentSoft}" BorderBrush="#3F53A0" BorderThickness="1" CornerRadius="14" Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="체크한 항목만 변경됩니다." Foreground="#E0E4FF" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크하지 않은 메시지·일정·전송 한도·사용 여부는 그대로 유지합니다." Foreground="#A4AFDE" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="선택한 방에 변경 적용" Click="ApplyBulk_Click" Padding="20,10"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0B1119" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="13" Padding="12" Margin="0,12,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="전송 전에 연결 상태를 확인하거나 선택한 방에 1회 테스트 전송할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0,0,7,0"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click" Margin="0,0,7,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="RemoveSelected_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="운영 · 진단">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,7,8">
                            <StackPanel MaxWidth="1040" HorizontalAlignment="Center" Margin="2,2,7,14">
                                <TextBlock Text="운영 상태" FontSize="26" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,18"/>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <TextBlock Text="연결 상태 검사" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="카카오톡 재시작·창 변경·대상 불일치를 다시 검증합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                                <Button Grid.Column="2" Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <TextBlock Text="창 닫기 동작" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="트레이로 숨기면 자동전송을 계속 유지할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12"/>
                                            <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼을 누르면 트레이로 숨김" IsChecked="True" Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="설정 보관" FontSize="14" FontWeight="SemiBold"/>
                                            <TextBlock Text="방 설정은 자동 저장되며 settings.json과 마지막 정상 백업으로 로컬 PC에 보관됩니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="설정 폴더 열기" Click="OpenSettingsFolder_Click" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Border Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="14" Padding="3" Height="320">
                                    <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Padding="12"/>
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="문제가 생기면 먼저 연결 상태를 확인한 뒤 로그를 확인하세요." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>