<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1380" Height="900" MinWidth="1120" MinHeight="740"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="82"/>
            <RowDefinition Height="74"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="30" FontWeight="Bold"/>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#746A00" BorderThickness="1"
                            CornerRadius="10" Padding="9,4" Margin="12,3,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText"
                           Text="자동전송 상태를 준비하고 있습니다."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click"/>
                <Button x:Name="StartAllButton" Style="{StaticResource PrimaryButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="17,9"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="17,9"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15,12" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" Background="{StaticResource SuccessSoft}" BorderBrush="#285C42"
                        BorderThickness="1" CornerRadius="19" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="15"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>

                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다."
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal"
                            VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBox x:Name="LicenseKeyBox" Width="275" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="자동전송 방" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개"
                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="새 방 연결" Click="PairCurrent_Click" Padding="13,7"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="#625900"
                            BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,11,0,10">
                        <TextBlock x:Name="PairingStatusText"
                                   Text="카카오톡 방의 입력칸을 클릭한 뒤 Ctrl+Shift+F8 또는 새 방 연결을 사용하세요."
                                   Foreground="#EDE49A" FontSize="11"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,9">
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름 / 상태 검색" TextChanged="RoomSearch_TextChanged"
                                 Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="전체"/>
                                <ComboBoxItem Content="실행 중"/>
                                <ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/>
                                <ComboBoxItem Content="연결 필요"/>
                                <ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="방 정렬">
                                <ComboBoxItem Content="상태 우선"/>
                                <ComboBoxItem Content="다음 전송"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CompactButton}" Content="현재 목록 전체 선택" Click="SelectAllRooms_Click" Margin="0"/>
                            <Button Grid.Column="2" Style="{StaticResource CompactButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0"/>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}"
                                        BorderThickness="1" Padding="12" CornerRadius="10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding BindingSummary}" Foreground="#8FB8A2" FontSize="11" Margin="0,4,0,0"/>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#B7C0CE" FontSize="11" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="32"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource AccentSoft}" BorderBrush="#5D5500"
                                                BorderThickness="1" CornerRadius="9" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Accent}" FontSize="11" FontWeight="Bold"
                                                       ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CompactButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Style="{StaticResource CompactButton}" Content="선택 중단" Click="StopSelected_Click" Margin="4,0,0,0"/>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CompactButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0,0,4,0"/>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click" Margin="4,0,0,0"/>
                        </Grid>
                        <Button Style="{StaticResource DangerButton}" Content="선택한 방 삭제" Click="RemoveSelected_Click" Margin="0,7,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <TabControl>
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                                    BorderThickness="1" Padding="10,9" Margin="0,8,0,0" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="EditorSaveStatusText"
                                               Text="변경사항 자동 저장 · Ctrl+S 저장 · Ctrl+Enter 1회 전송"
                                               Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="SaveRoomButton" Content="설정 저장" Click="SaveRoom_Click"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="이 방에 1회 전송" Click="TestSend_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,0,8">
                                <StackPanel Margin="2,2,8,12">
                                <TextBlock Text="선택한 방 설정" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,18"/>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                    <StackPanel>
                                        <TextBlock Text="기본 정보" FontSize="12" FontWeight="SemiBold" Foreground="#C8D0DC"/>
                                        <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,11,0,0"/>
                                        <TextBox x:Name="DisplayNameBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                    <StackPanel>
                                        <TextBlock Text="메시지" FontSize="12" FontWeight="SemiBold" Foreground="#C8D0DC"/>
                                        <TextBlock Text="이 방에 자동으로 보낼 내용을 입력하세요." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBox x:Name="MessageEditor" Height="132" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0"
                                                 TextChanged="SingleEditor_Changed"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                    <StackPanel>
                                        <TextBlock Text="전송 스케줄" FontSize="12" FontWeight="SemiBold" Foreground="#C8D0DC"/>
                                        <Grid Margin="0,11,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="방식" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                    <ComboBoxItem Content="간격 반복"/>
                                                    <ComboBoxItem Content="지정 시각"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="하루 최대 전송 · 0은 무제한" Foreground="{StaticResource Muted}" FontSize="11"/>
                                                <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="IntervalPanel" Margin="0,11,0,0">
                                            <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBox x:Name="IntervalBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                            <WrapPanel Margin="0,7,0,0">
                                                <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                        <StackPanel x:Name="TimesPanel" Margin="0,11,0,0" Visibility="Collapsed">
                                            <TextBlock Text="매일 전송 시각 · 예: 09:00, 13:30, 21:00" Foreground="{StaticResource Muted}" FontSize="11"/>
                                            <TextBox x:Name="TimesBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                        </StackPanel>
                                        <CheckBox x:Name="EnabledCheck" Content="이 방 자동전송 사용" IsChecked="True" Margin="0,13,0,0"
                                                  Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource WarningSoft}" BorderBrush="#5E540B" BorderThickness="1"
                                        CornerRadius="10" Padding="12" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="사진 전송은 아직 안전 잠금 상태입니다" Foreground="#F6E97C" FontWeight="SemiBold"/>
                                        <TextBlock Text="사진이 설정된 방은 PC 카카오 첨부 흐름이 검증될 때까지 텍스트만 보내지 않고 전송 자체를 차단합니다."
                                                   Foreground="#CFC68B" FontSize="11" Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Border>

                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="일괄 편집">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,2,8,12">
                                <TextBlock Text="여러 방 한 번에 수정" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,18"/>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                        <TextBlock Text="체크한 경우에만 선택한 모든 방의 메시지를 바꿉니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        <TextBox x:Name="BulkMessageEditor" Height="96" AcceptsReturn="True" TextWrapping="Wrap"
                                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,9,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ApplyScheduleCheck" Content="스케줄 변경" FontWeight="SemiBold"/>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                <ComboBoxItem Content="간격 반복"/>
                                                <ComboBoxItem Content="지정 시각"/>
                                            </ComboBox>
                                            <TextBox x:Name="BulkIntervalBox" Grid.Column="2" Text="60" ToolTip="간격 반복일 때 분 단위"/>
                                        </Grid>
                                        <WrapPanel Margin="0,7,0,0">
                                            <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click"/>
                                            <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click"/>
                                            <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click"/>
                                            <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click"/>
                                            <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                        </WrapPanel>
                                        <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,8,0,0" ToolTip="지정 시각일 때 예: 09:00, 13:30"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                            <TextBox x:Name="BulkDailyLimitBox" Text="8" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True" Margin="0,12,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="#0D1117" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="10" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="일괄 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="첫 번째 선택 방을 기준으로 복사하거나 체크한 항목만 적용할 수 있습니다."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                            <Button x:Name="UndoBulkButton" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="선택 항목 적용" Click="ApplyBulk_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <TextBlock Text="빠른 작업" FontWeight="SemiBold" Margin="0,18,0,7"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource CompactButton}" Content="사용 켜기" Click="EnableSelected_Click"/>
                                    <Button Style="{StaticResource CompactButton}" Content="사용 끄기" Click="DisableSelected_Click"/>
                                    <Button Style="{StaticResource CompactButton}" Content="선택 시작" Click="StartSelected_Click"/>
                                    <Button Style="{StaticResource CompactButton}" Content="선택 중단" Click="StopSelected_Click"/>
                                    <Button Style="{StaticResource CompactButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="운영 · 진단">
                        <Grid Margin="2,2,8,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 상태와 문제 해결" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,14"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,10">
                                <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                <Button Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                <Button Content="설정 폴더 열기" Click="OpenSettingsFolder_Click"/>
                                <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click"/>
                                <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼은 트레이로 숨김" IsChecked="True"
                                          Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"
                                          VerticalAlignment="Center" Margin="12,0,8,0" ToolTip="실수로 창을 닫아도 자동전송 엔진을 유지합니다."/>
                                <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                            </WrapPanel>
                            <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                     FontFamily="Consolas" FontSize="12" Background="#0B0F14" Padding="12"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
