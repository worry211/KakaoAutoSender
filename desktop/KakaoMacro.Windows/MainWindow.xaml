<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1180" Height="780" MinWidth="980" MinHeight="680"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="84"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="150"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="KakaoMacro PC" FontSize="28" FontWeight="Bold"/>
                <TextBlock Text="Windows v1 Preview · 안전 우선 방 바인딩" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="StartAllButton" Style="{StaticResource PrimaryButton}" Content="전체 시작" Click="StartAll_Click"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="기존 판매자 라이선스 서버와 연결합니다." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBox x:Name="LicenseKeyBox" Width="275" Margin="0,0,8,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="12" Padding="14">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="카톡방" FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="채팅방을 별도 창으로 열고 입력칸을 클릭한 뒤 Ctrl+Shift+F8" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/>
                        <TextBlock x:Name="PairingStatusText" Text="단축키 대기 중" Foreground="{StaticResource Accent}"/>
                    </StackPanel>
                    <ListBox x:Name="RoomList" Grid.Row="1" Margin="0,12,0,12" Background="#11141A" BorderBrush="#303642" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10" Margin="2" Background="#1A1E25" CornerRadius="8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                        <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                                        <TextBlock Text="{Binding LastStatus}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="선택 방 삭제" Click="RemoveRoom_Click"/>
                        <Button Content="연결 상태 확인" Click="ValidateRoom_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="12" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="방 설정" FontSize="20" FontWeight="Bold"/>
                        <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방을 선택하세요." Foreground="{StaticResource Muted}" Margin="0,5,0,18"/>

                        <TextBlock Text="내 표시 이름" FontWeight="SemiBold"/>
                        <TextBox x:Name="DisplayNameBox" Margin="0,6,0,14"/>

                        <TextBlock Text="보낼 메시지" FontWeight="SemiBold"/>
                        <TextBox x:Name="MessageEditor" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,14"/>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="스케줄 방식" FontWeight="SemiBold"/>
                                <ComboBox x:Name="ScheduleModeBox" Margin="0,6,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                    <ComboBoxItem Content="간격 반복"/>
                                    <ComboBoxItem Content="지정 시각"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="하루 최대 전송 (0=무제한)" FontWeight="SemiBold"/>
                                <TextBox x:Name="DailyLimitBox" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="IntervalPanel" Margin="0,0,0,14">
                            <TextBlock Text="반복 간격 (분)" FontWeight="SemiBold"/>
                            <TextBox x:Name="IntervalBox" Margin="0,6,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="TimesPanel" Margin="0,0,0,14" Visibility="Collapsed">
                            <TextBlock Text="매일 전송 시각 (예: 09:00, 13:30, 21:00)" FontWeight="SemiBold"/>
                            <TextBox x:Name="TimesBox" Margin="0,6,0,0"/>
                        </StackPanel>

                        <CheckBox x:Name="EnabledCheck" Content="이 방 자동전송 사용" IsChecked="True" Margin="0,2,0,14"/>

                        <Border Background="#241F13" BorderBrush="#6D5B12" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="사진 전송 안전 잠금" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                <TextBlock Text="PC v1에서는 카카오 확인창/첨부 UI를 검증하기 전 사진 자동전송을 막습니다. 사진이 설정된 프로필은 텍스트만 보내지 않고 전송 자체를 차단합니다." Foreground="#D7C982" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="저장" Click="SaveRoom_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="1회 테스트 전송" Click="TestSend_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Panel}" CornerRadius="12" Padding="12" Margin="0,14,0,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="진단 로그 · 메시지 본문/라이선스 키는 기록하지 않음" FontWeight="SemiBold"/>
                <TextBox x:Name="LogBox" Grid.Row="1" Margin="0,8,0,0" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
            </Grid>
        </Border>
    </Grid>
</Window>
