<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1480" Height="920" MinWidth="1180" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="30" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#61590E" BorderThickness="1"
                            CornerRadius="9" Padding="8,3" Margin="11,3,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#39458C" BorderThickness="1"
                            CornerRadius="9" Padding="8,3" Margin="7,3,0,0" VerticalAlignment="Top">
                        <TextBlock Text="v1.4" Foreground="#CAD0FF" FontSize="10" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="자동전송 상태를 준비하고 있습니다."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="14,8"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="18,9"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <!-- License / service state -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="36" Height="36" Background="{StaticResource Panel3}" BorderBrush="{StaticResource BorderStrong}"
                        BorderThickness="1" CornerRadius="18" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="14" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다."
                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="285" Margin="0,0,8,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Room navigator -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="자동전송 방" FontSize="20" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 새 방 연결" Click="PairCurrent_Click" Padding="14,8"/>
                    </Grid>

                    <Border Grid.Row="1" Background="#171A0B" BorderBrush="#5D5514" BorderThickness="1"
                            CornerRadius="10" Padding="11" Margin="0,11,0,10">
                        <StackPanel>
                            <TextBlock Text="방 연결" Foreground="#F0E59A" FontWeight="SemiBold" FontSize="11"/>
                            <TextBlock x:Name="PairingStatusText"
                                       Text="카카오톡 입력칸을 클릭한 뒤 Ctrl+Shift+F8로 연결하세요."
                                       Foreground="#BDB67A" FontSize="10" Margin="0,3,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름이나 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="7"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="모든 방"/>
                                <ComboBoxItem Content="실행 중"/>
                                <ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/>
                                <ComboBoxItem Content="연결 필요"/>
                                <ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬 기준">
                                <ComboBoxItem Content="상태 우선"/>
                                <ComboBoxItem Content="다음 전송"/>
                                <ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                        Padding="12" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="10" FontWeight="SemiBold"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="10"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#A7B0BF" FontSize="10" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Panel3}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="9" Padding="7,3" Margin="9,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="11" Padding="9" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Ctrl / Shift로 여러 방 선택" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Style="{StaticResource CompactButton}" Content="전체 선택" Click="SelectAllRooms_Click" Margin="0,0,5,0"/>
                                <Button Style="{StaticResource CompactButton}" Content="해제" Click="ClearSelection_Click" Margin="0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Context workspace -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="18">
                <TabControl>
                    <!-- Single room editor -->
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="12,10" Margin="0,10,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#C8CEFF" FontSize="11" FontWeight="SemiBold"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="SaveRoomButton" Content="저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button Content="시작" Style="{StaticResource SuccessButton}" Click="StartSelected_Click"/>
                                        <Button Content="중단" Click="StopSelected_Click"/>
                                        <Button Content="연결 확인" Style="{StaticResource GhostButton}" Click="ValidateSelected_Click"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="TestSend_Click" Padding="17,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                                <StackPanel Margin="2,2,5,12">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="선택한 방 설정" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSoft}" BorderBrush="#2E6548" BorderThickness="1"
                                                CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="변경 즉시 자동 저장" Foreground="#A6EFC9" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="기본 정보" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="표시 이름과 이 방의 사용 여부를 관리합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="자동전송 사용" IsChecked="True" Margin="12,0,0,0"
                                                          Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                            </Grid>
                                            <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,5"/>
                                            <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="보낼 메시지" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="이 방에 실제로 전송될 텍스트입니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="최대 4,000자" Foreground="{StaticResource Muted2}" FontSize="9" VerticalAlignment="Center"/>
                                            </Grid>
                                            <TextBox x:Name="MessageEditor" Height="138" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed" Margin="0,11,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,11">
                                        <StackPanel>
                                            <TextBlock Text="전송 일정" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="반복 간격 또는 매일 지정 시각 중 하나를 선택합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,11"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="방식" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectedIndex="0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="일정 간격마다 반복"/>
                                                        <ComboBoxItem Content="매일 지정한 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="0 = 제한 없음"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IntervalPanel" Margin="0,12,0,0">
                                                <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition/>
                                                        <ColumnDefinition Width="10"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" Text="60" TextChanged="SingleEditor_Changed"/>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel x:Name="TimesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <TextBox x:Name="TimesBox" Margin="0,5,0,0" Text="09:00" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#5B4C22" BorderThickness="1" CornerRadius="11" Padding="12">
                                        <StackPanel>
                                            <TextBlock Text="사진 자동전송 안전 잠금" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="사진이 설정된 방은 PC 사진 전송 검증이 완료될 때까지 텍스트만 보내지 않고 전송 전체를 차단합니다."
                                                       Foreground="#C9B98D" FontSize="10" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Multi room editor -->
                    <TabItem Header="여러 방 작업">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                            <StackPanel Margin="2,2,5,12">
                                <Grid Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="여러 방 한 번에 변경" FontSize="24" FontWeight="Bold"/>
                                        <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                                   Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                        <Button x:Name="UndoBulkButton" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,11">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition/>
                                        </Grid.ColumnDefinitions>
                                        <Button Style="{StaticResource SuccessButton}" Content="사용 켜기" Click="EnableSelected_Click" Margin="0"/>
                                        <Button Grid.Column="2" Content="사용 끄기" Click="DisableSelected_Click" Margin="0"/>
                                        <Button Grid.Column="4" Content="선택 시작" Click="StartSelected_Click" Margin="0"/>
                                        <Button Grid.Column="6" Content="선택 중단" Click="StopSelected_Click" Margin="0"/>
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="11"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크한 경우에만 선택된 모든 방의 메시지를 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <TextBox x:Name="BulkMessageEditor" Height="124" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyScheduleCheck" Content="전송 일정 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크한 경우에만 선택된 방의 전송 시간을 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                <ComboBoxItem Content="일정 간격마다 반복"/>
                                                <ComboBoxItem Content="매일 지정한 시각"/>
                                            </ComboBox>
                                            <Grid Margin="0,7,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="9"/>
                                                    <ColumnDefinition/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="BulkIntervalBox" Text="60" ToolTip="간격 반복일 때 분 단위"/>
                                                <TextBox x:Name="BulkTimesBox" Grid.Column="2" Text="09:00" ToolTip="지정 시각일 때 예: 09:00, 13:30"/>
                                            </Grid>
                                            <WrapPanel Margin="0,6,0,0">
                                                <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="11"/>
                                        <ColumnDefinition/>
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="0을 입력하면 제한 없음" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,8"/>
                                            <TextBox x:Name="BulkDailyLimitBox" Text="8"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                            <TextBlock Text="선택한 방을 한 번에 사용/중지 상태로 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                            <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <Border Background="{StaticResource AccentSoft}" BorderBrush="#36438E" BorderThickness="1" CornerRadius="12" Padding="13">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="체크한 항목만 변경" Foreground="#D7DBFF" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크하지 않은 메시지·일정·한도·사용 상태는 그대로 유지됩니다."
                                                       Foreground="#9CA6D8" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="선택한 방에 적용" Click="ApplyBulk_Click" Padding="19,10"/>
                                    </Grid>
                                </Border>

                                <Border Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,11,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="일괄 변경 후 실행 상태가 바뀐 방은 필요하면 다시 시작하세요." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                                            <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="RemoveSelected_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Runtime / diagnostics -->
                    <TabItem Header="운영 · 진단">
                        <Grid Margin="2,2,5,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="운영 상태" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,5,0,15"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="연결 상태" FontWeight="SemiBold"/>
                                        <TextBlock Text="카카오톡 재시작·창 변경·대상 불일치를 다시 검증합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <WrapPanel>
                                            <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                            <Button Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="창 닫기 동작" FontWeight="SemiBold"/>
                                        <TextBlock Text="트레이로 숨기면 자동전송을 계속 유지할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼을 누르면 트레이로 숨김" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="방 설정은 자동 저장되며 settings.json + 마지막 정상 백업으로 로컬 PC에 보관됩니다."
                                               Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="설정 폴더" Click="OpenSettingsFolder_Click"/>
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="11" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>
