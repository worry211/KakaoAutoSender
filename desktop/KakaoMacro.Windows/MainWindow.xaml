<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC · v1.4" Width="1480" Height="920" MinWidth="1180" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="68"/>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="28" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#6A620B" BorderThickness="1"
                            CornerRadius="9" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC · v1.4" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="운영 상태를 확인하고 있습니다."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="14,8"/>
                <Button x:Name="StartAllButton" Style="{StaticResource PrimaryButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="18,9"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,9"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource AccentSoft}" BorderBrush="#3D4A99"
                        BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다."
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="275" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="자동전송 방" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 새 방 연결" Click="PairCurrent_Click" Padding="13,8"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="#344080" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,10,0,10">
                        <TextBlock x:Name="PairingStatusText" Text="카카오톡 입력칸을 클릭한 뒤 Ctrl+Shift+F8로 연결하세요."
                                   Foreground="#C7CCFF" FontSize="10"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="검색" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,0,0,5"/>
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름이나 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="모든 방"/><ComboBoxItem Content="실행 중"/><ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/><ComboBoxItem Content="연결 필요"/><ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬 기준">
                                <ComboBoxItem Content="상태 우선"/><ComboBoxItem Content="다음 전송"/><ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource GhostButton}" Content="현재 목록 전체 선택" Click="SelectAllRooms_Click" Margin="0" Padding="9,6" FontSize="11"/>
                            <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0" Padding="9,6" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="11" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="10"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="10"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#ADB6C5" FontSize="10" Margin="0,5,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="30"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Panel3}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="9" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="선택한 방 작업" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,0,0,7"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SuccessButton}" Content="시작" Click="StartSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Content="중단" Click="StopSelected_Click" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="SendSelectedNow_Click" Margin="0"/>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Danger}" Content="선택한 방 삭제" Click="RemoveSelected_Click" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <TabControl>
                    <TabItem Header="선택한 방">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="11,9" Margin="0,10,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#C7CCFF" FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="입력한 변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SaveRoomButton" Content="저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 테스트 전송" Click="TestSend_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                                <StackPanel Margin="2,2,5,10">
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="선택한 방 설정" FontSize="24" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSoft}" BorderBrush="#2E6548" BorderThickness="1"
                                                CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="변경 즉시 자동 저장" Foreground="#A6EFC9" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <TextBlock Text="메시지" FontSize="14" FontWeight="SemiBold"/>
                                                <TextBlock Text="이 방에 전송할 내용을 관리합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,12"/>
                                                <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <TextBox x:Name="DisplayNameBox" Margin="0,5,0,12" TextChanged="SingleEditor_Changed"/>
                                                <TextBlock Text="보낼 메시지" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <TextBox x:Name="MessageEditor" Height="245" Margin="0,5,0,0" AcceptsReturn="True" TextWrapping="Wrap"
                                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="전송 규칙" FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text="언제, 몇 번 보낼지 정합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                    <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="이 방 사용" IsChecked="True" Margin="12,0,0,0"
                                                              Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                                </Grid>
                                                <TextBlock Text="전송 방식" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,15,0,0"/>
                                                <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                    <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                                </ComboBox>
                                                <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0"/>
                                                <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="0을 입력하면 제한 없음"/>
                                                <TextBlock Text="0 = 제한 없음" Foreground="{StaticResource Muted2}" FontSize="9" Margin="2,3,0,0"/>

                                                <StackPanel x:Name="IntervalPanel" Margin="0,12,0,0">
                                                    <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <TextBox x:Name="IntervalBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                                <StackPanel x:Name="TimesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                    <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <TextBox x:Name="TimesBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                                    <TextBlock Text="쉼표로 여러 시각을 구분하세요." Foreground="{StaticResource Muted2}" FontSize="9" Margin="2,3,0,0"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#5B4C22" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,11,0,0">
                                        <TextBlock Text="사진이 설정된 방은 PC 사진 전송 검증이 끝날 때까지 전송 전체를 안전하게 차단합니다. 텍스트만 임의 전송하지 않습니다."
                                                   Foreground="#C9B98D" FontSize="10"/>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="일괄 편집">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="적용하면 선택한 방에 즉시 반영되고 자동 저장됩니다." FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock Text="체크하지 않은 항목은 절대 바뀌지 않습니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                        <Button x:Name="UndoBulkButton" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="선택한 방에 적용" Click="ApplyBulk_Click" Padding="18,9"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,8">
                                <StackPanel Margin="2,2,5,10">
                                    <TextBlock Text="여러 방 한 번에 수정" FontSize="24" FontWeight="Bold"/>
                                    <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,12"/>

                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#344080" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,12">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="빠른 작업" Foreground="#C7CCFF" FontWeight="SemiBold" FontSize="10" VerticalAlignment="Center"/>
                                            <WrapPanel Grid.Column="1">
                                                <Button Style="{StaticResource CompactButton}" Content="사용 켜기" Click="EnableSelected_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="사용 끄기" Click="DisableSelected_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="시작" Click="StartSelected_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="중단" Click="StopSelected_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                                <Button Style="{StaticResource CompactButton}" Content="지금 1회 전송" Click="SendSelectedNow_Click"/>
                                            </WrapPanel>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택한 모든 방의 메시지를 같은 내용으로 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                                <TextBox x:Name="BulkMessageEditor" Height="128" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                                                         VerticalScrollBarVisibility="Auto" IsEnabled="{Binding IsChecked, ElementName=ApplyMessageCheck}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}" Margin="0,0,0,12">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyScheduleCheck" Content="스케줄 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="체크했을 때만 전송 방식과 시간이 바뀝니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                                <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0" IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}">
                                                    <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                                </ComboBox>
                                                <TextBox x:Name="BulkIntervalBox" Text="60" Margin="0,7,0,0" ToolTip="간격 반복일 때 분 단위"
                                                         IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}"/>
                                                <WrapPanel Margin="0,5,0,0" IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}">
                                                    <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click"/>
                                                    <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                                </WrapPanel>
                                                <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,6,0,0" ToolTip="지정 시각일 때 예: 09:00, 13:30"
                                                         IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="0은 제한 없음입니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                                <TextBox x:Name="BulkDailyLimitBox" Text="8" IsEnabled="{Binding IsChecked, ElementName=ApplyDailyLimitCheck}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택한 방을 한 번에 사용 또는 일시정지 상태로 바꿉니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                                <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"
                                                          IsEnabled="{Binding IsChecked, ElementName=ApplyEnabledCheck}"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <TabItem Header="상태 · 기록">
                        <Grid Margin="2,2,5,7">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 상태" FontSize="24" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,14"/>
                            </StackPanel>
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="연결 상태" FontWeight="SemiBold"/>
                                        <TextBlock Text="15초마다 카카오톡 방 연결을 자동 점검합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <WrapPanel><Button Content="선택 확인" Click="ValidateSelected_Click"/><Button Content="전체 확인" Click="ValidateAll_Click"/></WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="창 닫기 동작" FontWeight="SemiBold"/>
                                        <TextBlock Text="작업 중 실수로 프로그램을 종료하지 않도록 보호합니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼은 트레이로 숨김" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="설정 보호" FontWeight="SemiBold"/>
                                        <TextBlock Text="변경사항은 자동 저장되고 복구용 백업도 로컬에 유지됩니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <Button Style="{StaticResource GhostButton}" Content="설정 폴더 열기" Click="OpenSettingsFolder_Click" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="2" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="10" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="실행 기록에는 메시지 본문을 남기지 않습니다." Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click"/>
                                        <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Grid.Row="3" Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11"
                                         Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>