<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1480" Height="920" MinWidth="1220" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="62"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Product header -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="28" FontWeight="Bold"/>
                    <Border Background="{StaticResource BrandSoft}" BorderBrush="#665D09" BorderThickness="1"
                            CornerRadius="8" Padding="8,3" Margin="10,2,0,0" VerticalAlignment="Top">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="10" FontWeight="Bold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="자동전송 상태를 준비하고 있습니다."
                           Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Padding="13,7" Margin="0,0,7,0"/>
                <Button x:Name="StartAllButton" Style="{StaticResource SuccessButton}" Content="전체 자동전송 시작" Click="StartAll_Click" Padding="18,8" Margin="0,0,7,0"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="18,8"/>
            </StackPanel>
        </Grid>

        <!-- License strip -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="13,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="34" Height="34" Background="{StaticResource SuccessSoft}" BorderBrush="#2F6849"
                        BorderThickness="1" CornerRadius="17" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Success}" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다."
                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="270" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main workspace -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <!-- Left operations rail -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="자동전송 방" FontSize="19" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 새 방 연결" Click="PairCurrent_Click" Padding="13,7"/>
                    </Grid>

                    <Border Grid.Row="1" Background="{StaticResource AccentSoft}" BorderBrush="#344080" BorderThickness="1"
                            CornerRadius="10" Padding="10" Margin="0,10,0,10">
                        <TextBlock x:Name="PairingStatusText"
                                   Text="카카오톡 입력칸 클릭 → Ctrl+Shift+F8로 현재 방을 연결합니다."
                                   Foreground="#C7CCFF" FontSize="10"/>
                    </Border>

                    <StackPanel Grid.Row="2" Margin="0,0,0,10">
                        <TextBlock Text="방 찾기" Foreground="{StaticResource Muted}" FontSize="10" Margin="2,0,0,5"/>
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름이나 상태 검색" TextChanged="RoomSearch_TextChanged"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                                <ComboBoxItem Content="모든 방"/><ComboBoxItem Content="실행 중"/><ComboBoxItem Content="일시정지"/>
                                <ComboBoxItem Content="사용 설정"/><ComboBoxItem Content="연결 필요"/><ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬 기준">
                                <ComboBoxItem Content="상태 우선"/><ComboBoxItem Content="다음 전송"/><ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource CompactButton}" Content="현재 목록 선택" Click="SelectAllRooms_Click" Margin="0"/>
                            <Button Grid.Column="2" Style="{StaticResource CompactButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0"/>
                        </Grid>
                    </StackPanel>

                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel2}" BorderBrush="{StaticResource Border}" BorderThickness="1" Padding="11" CornerRadius="11">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding BindingSummary}" Foreground="#B4BECE" FontSize="10"/>
                                                <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="10"/>
                                                <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="10"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#818C9D" FontSize="10" Margin="0,4,0,0"
                                                       TextTrimming="CharacterEllipsis" MaxHeight="29"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource Field}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="7,3" Margin="8,0,0,0" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" ToolTip="오늘 전송 횟수"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="4" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="9" Margin="0,9,0,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource SuccessButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Content="선택 중단" Click="StopSelected_Click" Margin="0"/>
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0"/>
                                <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="1회 전송" Click="SendSelectedNow_Click" Margin="0"/>
                            </Grid>
                            <Button Style="{StaticResource GhostButton}" Foreground="{StaticResource Danger}" Content="선택한 방 삭제" Click="RemoveSelected_Click" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Right workspace -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <TabControl>
                    <!-- Single room editor -->
                    <TabItem Header="방 설정">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="11,9" Margin="0,9,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="자동 저장" Foreground="#C7CCFF" FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock x:Name="EditorSaveStatusText" Text="변경사항은 자동으로 저장됩니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button x:Name="SaveRoomButton" Content="설정 저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                        <Button Style="{StaticResource GhostButton}" Content="연결 다시 확인" Click="ValidateSelected_Click" Margin="0,0,7,0"/>
                                        <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 테스트" Click="TestSend_Click" Padding="17,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,8">
                                <StackPanel Margin="2,2,5,12">
                                    <Grid Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="방 자동전송 설정" FontSize="23" FontWeight="Bold"/>
                                            <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요."
                                                       Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="{StaticResource SuccessSoft}" BorderBrush="#2E6548" BorderThickness="1"
                                                CornerRadius="10" Padding="10,5" VerticalAlignment="Center">
                                            <TextBlock Text="자동 저장 켜짐" Foreground="#A6EFC9" FontSize="10" FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="기본 정보" FontSize="13" FontWeight="SemiBold"/>
                                                    <TextBlock Text="방 목록에서 구분할 이름과 이 방의 사용 여부를 관리합니다."
                                                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="이 방 자동전송 사용" IsChecked="True" Margin="14,0,0,0"
                                                          Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                            </Grid>
                                            <TextBlock Text="표시 이름" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,5"/>
                                            <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="보낼 메시지" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="이 방에 실제로 전송될 내용을 입력하세요. 입력한 내용은 자동 저장됩니다."
                                                       Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,8"/>
                                            <TextBox x:Name="MessageEditor" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <TextBlock Text="전송 규칙" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="반복 간격 또는 매일 지정 시각 중 하나를 선택합니다."
                                                       Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="방식" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <ComboBox x:Name="ScheduleModeBox" Margin="0,5,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                        <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                                    </ComboBox>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="0을 입력하면 제한 없음"/>
                                                    <TextBlock Text="0이면 제한 없음" Foreground="{StaticResource Muted2}" FontSize="9" Margin="2,3,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <StackPanel x:Name="IntervalPanel" Margin="0,12,0,0">
                                                <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox x:Name="IntervalBox" TextChanged="SingleEditor_Changed" ToolTip="분 단위"/>
                                                    <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click" Margin="0"/>
                                                    </WrapPanel>
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel x:Name="TimesPanel" Margin="0,12,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="10"/>
                                                <TextBox x:Name="TimesBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                                <TextBlock Text="여러 시각은 쉼표로 구분하세요. 예: 09:00, 13:30, 21:00"
                                                           Foreground="{StaticResource Muted2}" FontSize="9" Margin="2,3,0,0"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="{StaticResource WarningSoft}" BorderBrush="#5B4C22" BorderThickness="1" CornerRadius="11" Padding="11">
                                        <StackPanel>
                                            <TextBlock Text="사진 자동전송은 안전 잠금 상태" Foreground="{StaticResource Warning}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="사진이 설정된 방은 검증이 끝날 때까지 텍스트만 보내지 않고 전송 전체를 차단합니다."
                                                       Foreground="#C9B98D" FontSize="10" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Bulk editor -->
                    <TabItem Header="일괄 편집">
                        <DockPanel LastChildFill="True">
                            <Border DockPanel.Dock="Bottom" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1"
                                    Padding="11,9" Margin="0,9,0,0" CornerRadius="11">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="선택한 항목만 변경" Foreground="#C7CCFF" FontWeight="SemiBold" FontSize="10"/>
                                        <TextBlock Text="체크하지 않은 설정은 현재 값 그대로 유지됩니다." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click" Margin="0,0,7,0"/>
                                        <Button x:Name="UndoBulkButton" Content="마지막 변경 되돌리기" Click="UndoBulk_Click" IsEnabled="False" Margin="0,0,7,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="선택한 항목 적용" Click="ApplyBulk_Click" Padding="17,8"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,5,8">
                                <StackPanel Margin="2,2,5,12">
                                    <TextBlock Text="여러 방 일괄 편집" FontSize="23" FontWeight="Bold"/>
                                    <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요."
                                               Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,13"/>

                                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#344080" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,10">
                                        <TextBlock Text="수정할 항목의 체크를 켠 뒤 값을 입력하세요. 체크하지 않은 항목은 절대 덮어쓰지 않습니다."
                                                   Foreground="#C7CCFF" FontSize="10"/>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyMessageCheck" Content="메시지 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택한 모든 방의 전송 문구를 같은 내용으로 맞춥니다."
                                                           Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                                            </StackPanel>
                                            <TextBox x:Name="BulkMessageEditor" Grid.Column="2" Height="105" AcceptsReturn="True" TextWrapping="Wrap"
                                                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/>
                                        </Grid>
                                    </Border>

                                    <Border Style="{StaticResource SoftCard}" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <CheckBox x:Name="ApplyScheduleCheck" Content="스케줄 변경" FontWeight="SemiBold"/>
                                                    <TextBlock Text="반복 간격 또는 지정 시각을 한 번에 변경합니다."
                                                               Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                        <ComboBoxItem Content="일정 간격마다 반복"/><ComboBoxItem Content="매일 지정한 시각"/>
                                                    </ComboBox>
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                            <TextBox x:Name="BulkIntervalBox" Text="60" Margin="0,4,0,0"/>
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2">
                                                            <TextBlock Text="지정 시각" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                            <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,4,0,0" ToolTip="예: 09:00, 13:30"/>
                                                        </StackPanel>
                                                    </Grid>
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click" Margin="0"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="0이면 제한 없음" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,8"/>
                                                <TextBox x:Name="BulkDailyLimitBox" Text="8"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                            <StackPanel>
                                                <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 변경" FontWeight="SemiBold"/>
                                                <TextBlock Text="선택한 방을 한 번에 사용 또는 사용 안 함으로 변경합니다."
                                                           Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,9"/>
                                                <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>

                    <!-- Operations / diagnostics -->
                    <TabItem Header="운영 · 진단">
                        <Grid Margin="2,2,5,7">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 · 진단" FontSize="23" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,13"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="카카오 연결 상태" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="카카오톡 재시작, 창 변경, 포커스 식별 이상을 다시 검증합니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <WrapPanel>
                                            <Button Content="선택 방 확인" Click="ValidateSelected_Click" Margin="0,0,6,0"/>
                                            <Button Content="전체 방 확인" Click="ValidateAll_Click" Margin="0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource SoftCard}">
                                    <StackPanel>
                                        <TextBlock Text="창 닫기 동작" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Text="X 버튼을 눌러도 트레이에서 자동전송을 계속 유지할 수 있습니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼은 트레이로 숨김" IsChecked="True"
                                                  Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="2" Background="#0C1118" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="11" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="설정 데이터 보호" FontWeight="SemiBold" FontSize="11"/>
                                        <TextBlock Text="settings.json은 자동 저장되며 마지막 정상본을 settings.json.bak으로 보관합니다. 손상 시 자동 복구하고 손상본도 남깁니다."
                                                   Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource GhostButton}" Content="설정 폴더 열기" Click="OpenSettingsFolder_Click" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <Border Grid.Row="3" Background="#080D13" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="11" Padding="3">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                                         FontFamily="Consolas" FontSize="10" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>

                            <Grid Grid.Row="4" Margin="0,9,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="로그에는 방 메시지 내용이나 라이선스 키를 기록하지 않습니다."
                                           Foreground="{StaticResource Muted2}" FontSize="9" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click" Margin="0,0,7,0"/>
                                    <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>