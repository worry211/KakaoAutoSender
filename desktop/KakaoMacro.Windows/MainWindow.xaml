<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1460" Height="900" MinWidth="1180" MinHeight="760"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Background="{StaticResource Bg}" Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="58"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro" FontSize="27" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Border Background="{StaticResource BrandSoft}" CornerRadius="7" Padding="7,2" Margin="9,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PC" Foreground="{StaticResource Brand}" FontSize="9" FontWeight="Bold"/>
                    </Border>
                    <Border Background="{StaticResource AccentSoft}" CornerRadius="7" Padding="7,2" Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.6" Foreground="#D5D9FF" FontSize="9" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="자동전송 상태를 준비하고 있습니다." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click" Margin="0,0,7,0"/>
                <Button x:Name="StartAllButton" Style="{StaticResource PrimaryButton}" Content="전체 시작" Click="StartAll_Click" Padding="18,8" Margin="0,0,7,0"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click" Padding="16,8"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Panel}" CornerRadius="12" Padding="14,9">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="30" Height="30" Background="{StaticResource AccentSoft}" CornerRadius="15" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="{StaticResource Accent}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="10,0,18,0" VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBox x:Name="LicenseKeyBox" Width="270" MinHeight="34" Margin="0,0,7,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="인증" Click="Activate_Click" MinHeight="34" Padding="14,6"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="326"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource Panel}" CornerRadius="14" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="자동전송 방" FontSize="18" FontWeight="Bold"/>
                            <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 방 연결" Click="PairCurrent_Click" Padding="12,7"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,11,0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="8"/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Accent}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="PairingStatusText" Grid.Column="2" Text="카카오톡 입력칸 클릭 → Ctrl+Shift+F8" Foreground="{StaticResource Muted}" FontSize="9" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,0,0,9">
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름 또는 상태 검색" TextChanged="RoomSearch_TextChanged" Margin="0,0,0,7"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="7"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="RoomFilterBox" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="상태 필터">
                                <ComboBoxItem Content="모든 방"/><ComboBoxItem Content="실행 중"/><ComboBoxItem Content="일시정지"/><ComboBoxItem Content="사용 설정"/><ComboBoxItem Content="연결 필요"/><ComboBoxItem Content="확인 필요"/>
                            </ComboBox>
                            <ComboBox x:Name="RoomSortBox" Grid.Column="2" SelectionChanged="RoomSortBox_SelectionChanged" ToolTip="정렬">
                                <ComboBoxItem Content="상태 우선"/><ComboBoxItem Content="다음 전송"/><ComboBoxItem Content="이름 순"/>
                            </ComboBox>
                        </Grid>
                    </StackPanel>
                    <ListBox x:Name="RoomList" Grid.Row="3" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="11,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Text="{Binding BindingSummary}" Foreground="{StaticResource Success}" FontSize="9" FontWeight="SemiBold"/>
                                            <TextBlock Text="  ·  " Foreground="{StaticResource Muted2}" FontSize="9"/>
                                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="9"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastStatus}" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" MaxHeight="28"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{StaticResource Panel3}" CornerRadius="7" Padding="6,2" Margin="8,0,0,0" VerticalAlignment="Top">
                                        <TextBlock Text="{Binding TodayCount}" Foreground="{StaticResource Muted}" FontSize="9" ToolTip="오늘 전송 횟수"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Grid Grid.Row="4" Margin="0,9,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="6"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Style="{StaticResource QuietButton}" Content="전체 선택" Click="SelectAllRooms_Click" Margin="0"/>
                        <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="선택 해제" Click="ClearSelection_Click" Margin="0"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource Panel}" CornerRadius="14" Padding="16">
                <TabControl>
                    <TabItem Header="방 설정">
                        <Grid Margin="2,4,2,2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="방 설정" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="BoundRoomText" Text="왼쪽에서 방 하나를 선택하세요." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="EditorSaveStatusText" Text="변경사항은 자동으로 저장됩니다." Foreground="{StaticResource Accent}" FontSize="9" Margin="0,3,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="SaveRoomButton" Content="저장" Click="SaveRoom_Click" Visibility="Collapsed"/>
                                    <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click" Margin="0,0,6,0"/>
                                    <Button Content="일시정지" Click="StopSelected_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="지금 1회 전송" Click="TestSend_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource SuccessButton}" Content="이 방 시작" Click="StartSelected_Click"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                                <Grid Margin="0,0,4,6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1.42*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="보낼 메시지" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="이 방에 실제로 전송될 내용을 입력하세요." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,7"/>
                                        <TextBox x:Name="MessageEditor" Height="310" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" TextChanged="SingleEditor_Changed"/>
                                        <Border Background="{StaticResource WarningSoft}" CornerRadius="9" Padding="10,8" Margin="0,10,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="사진 전송 잠금" Foreground="{StaticResource Warning}" FontSize="9" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                                <TextBlock Text="사진이 설정된 방은 PC 사진 전송 검증 전까지 전체 전송을 차단합니다." Foreground="{StaticResource Muted}" FontSize="9"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="12" Padding="15">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="전송 설정" FontSize="14" FontWeight="SemiBold"/>
                                                    <TextBlock Text="입력하는 즉시 자동 저장됩니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <CheckBox x:Name="EnabledCheck" Grid.Column="1" Content="사용" IsChecked="True" Margin="12,0,0,0" Checked="SingleEditor_ToggleChanged" Unchecked="SingleEditor_ToggleChanged"/>
                                            </Grid>
                                            <TextBlock Text="방 표시 이름" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,15,0,5"/>
                                            <TextBox x:Name="DisplayNameBox" TextChanged="SingleEditor_Changed"/>
                                            <TextBlock Text="일정 방식" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,13,0,5"/>
                                            <ComboBox x:Name="ScheduleModeBox" SelectedIndex="0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                                <ComboBoxItem Content="간격 반복"/><ComboBoxItem Content="매일 지정 시각"/>
                                            </ComboBox>
                                            <Grid Margin="0,11,0,0">
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="9"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="하루 최대 전송" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                    <TextBox x:Name="DailyLimitBox" Margin="0,5,0,0" TextChanged="SingleEditor_Changed" ToolTip="0 = 제한 없음"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" x:Name="IntervalPanel">
                                                    <TextBlock Text="반복 간격 (분)" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                    <TextBox x:Name="IntervalBox" Text="60" Margin="0,5,0,0" TextChanged="SingleEditor_Changed"/>
                                                </StackPanel>
                                            </Grid>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="IntervalPreset_Click" Margin="0,0,5,5"/>
                                                <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="IntervalPreset_Click" Margin="0,0,5,5"/>
                                                <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="IntervalPreset_Click" Margin="0,0,5,5"/>
                                                <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="IntervalPreset_Click" Margin="0,0,5,5"/>
                                                <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="IntervalPreset_Click" Margin="0,0,0,5"/>
                                            </WrapPanel>
                                            <StackPanel x:Name="TimesPanel" Margin="0,8,0,0" Visibility="Collapsed">
                                                <TextBlock Text="매일 전송 시각" Foreground="{StaticResource Muted}" FontSize="9"/>
                                                <TextBox x:Name="TimesBox" Margin="0,5,0,0" Text="09:00" TextChanged="SingleEditor_Changed" ToolTip="예: 09:00, 13:30, 21:00"/>
                                            </StackPanel>
                                            <Border Background="#0D141C" CornerRadius="9" Padding="10" Margin="0,14,0,0">
                                                <TextBlock Text="카카오톡이 재시작되거나 연결한 방의 식별 정보가 달라지면 자동으로 중지합니다." Foreground="{StaticResource Muted}" FontSize="9"/>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <TabItem Header="여러 방 작업">
                        <Grid Margin="2,4,2,2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="여러 방 작업" FontSize="22" FontWeight="Bold"/>
                                    <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Content="첫 방 설정 복사" Click="CopyPrimaryToSelected_Click" Margin="0,0,6,0"/>
                                    <Button x:Name="UndoBulkButton" Content="되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                </StackPanel>
                            </Grid>
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,0,5,0">
                                <StackPanel Margin="0,0,4,4">
                                    <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14">
                                        <StackPanel>
                                            <TextBlock Text="바꿀 항목" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="체크한 항목만 선택된 방에 적용되고, 나머지는 그대로 유지됩니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,3,0,12"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <CheckBox x:Name="ApplyMessageCheck" Content="메시지" FontWeight="SemiBold"/>
                                                    <TextBox x:Name="BulkMessageEditor" IsEnabled="{Binding IsChecked, ElementName=ApplyMessageCheck}" Height="118" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <CheckBox x:Name="ApplyScheduleCheck" Content="전송 일정" FontWeight="SemiBold"/>
                                                    <ComboBox x:Name="BulkScheduleModeBox" IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}" SelectedIndex="0" Margin="0,7,0,0">
                                                        <ComboBoxItem Content="간격 반복"/><ComboBoxItem Content="매일 지정 시각"/>
                                                    </ComboBox>
                                                    <Grid Margin="0,7,0,0">
                                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                        <TextBox x:Name="BulkIntervalBox" IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}" Text="60" ToolTip="간격 반복일 때 분 단위"/>
                                                        <TextBox x:Name="BulkTimesBox" Grid.Column="2" IsEnabled="{Binding IsChecked, ElementName=ApplyScheduleCheck}" Text="09:00" ToolTip="지정 시각일 때 예: 09:00, 13:30"/>
                                                    </Grid>
                                                    <WrapPanel Margin="0,6,0,0">
                                                        <Button Style="{StaticResource CompactButton}" Content="1분" Tag="1" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="5분" Tag="5" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="10분" Tag="10" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="30분" Tag="30" Click="BulkIntervalPreset_Click" Margin="0,0,5,0"/>
                                                        <Button Style="{StaticResource CompactButton}" Content="1시간" Tag="60" Click="BulkIntervalPreset_Click"/>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </Grid>
                                            <Border Height="1" Background="{StaticResource Border}" Margin="0,14"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송" FontWeight="SemiBold"/>
                                                    <TextBlock Text="0 = 제한 없음" Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,6"/>
                                                    <TextBox x:Name="BulkDailyLimitBox" IsEnabled="{Binding IsChecked, ElementName=ApplyDailyLimitCheck}" Text="8"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부" FontWeight="SemiBold"/>
                                                    <TextBlock Text="선택된 방의 자동전송 사용 상태를 함께 변경합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,10"/>
                                                    <CheckBox x:Name="BulkEnabledCheck" IsEnabled="{Binding IsChecked, ElementName=ApplyEnabledCheck}" Content="자동전송 사용" IsChecked="True"/>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                            <Grid Grid.Row="4">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource QuietButton}" Content="사용 켜기" Click="EnableSelected_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource QuietButton}" Content="사용 끄기" Click="DisableSelected_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource QuietButton}" Content="선택 시작" Click="StartSelected_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource QuietButton}" Content="선택 중단" Click="StopSelected_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="연결 확인" Click="ValidateSelected_Click"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Style="{StaticResource GhostButton}" Content="선택 삭제" Click="RemoveSelected_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource GhostButton}" Content="1회 전송" Click="SendSelectedNow_Click" Margin="0,0,6,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="체크한 변경 적용" Click="ApplyBulk_Click" Padding="18,8"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <TabItem Header="운영">
                        <Grid Margin="2,4,2,2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 · 진단" FontSize="22" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                <Border Background="{StaticResource Panel2}" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="연결 상태" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="카카오톡 재시작·창 변경·대상 불일치를 다시 검증합니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,10"/>
                                        <WrapPanel>
                                            <Button Style="{StaticResource GhostButton}" Content="선택 연결 확인" Click="ValidateSelected_Click" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource PrimaryButton}" Content="전체 연결 확인" Click="ValidateAll_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{StaticResource Panel2}" CornerRadius="12" Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="앱 동작" FontSize="12" FontWeight="SemiBold"/>
                                        <TextBlock Text="설정은 자동 저장되며 마지막 정상 백업에서 자동 복구할 수 있습니다." Foreground="{StaticResource Muted}" FontSize="9" Margin="0,4,0,9"/>
                                        <CheckBox x:Name="CloseToTrayCheck" Content="X 버튼을 누르면 트레이로 숨김" IsChecked="True" Checked="CloseToTrayCheck_Changed" Unchecked="CloseToTrayCheck_Changed"/>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource GhostButton}" Content="설정 폴더" Click="OpenSettingsFolder_Click" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource GhostButton}" Content="로그 지우기" Click="ClearLog_Click" Margin="0,0,6,0"/>
                                            <Button Style="{StaticResource DangerButton}" Content="프로그램 종료" Click="ExitApp_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <Border Grid.Row="4" Background="#0A0F16" CornerRadius="11" Padding="2">
                                <TextBox x:Name="LogBox" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="10" Background="Transparent" BorderThickness="0" Padding="11"/>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>