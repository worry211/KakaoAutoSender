<Window x:Class="KakaoMacro.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KakaoMacro PC" Width="1320" Height="860" MinWidth="1080" MinHeight="720"
        Background="#0B0D11" Foreground="#F7F8FA"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="18" Background="#0B0D11">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="KakaoMacro PC" FontSize="29" FontWeight="Bold"/>
                    <Border Background="{StaticResource AccentSoft}" BorderBrush="#665C00" BorderThickness="1" CornerRadius="10" Padding="9,3" Margin="12,4,0,0">
                        <TextBlock Text="v1.2 Preview" Foreground="{StaticResource Accent}" FontSize="12" FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="DashboardText" Text="방과 라이선스 상태를 확인하는 중입니다." Foreground="{StaticResource Muted}" Margin="0,5,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource GhostButton}" Content="트레이로 숨기기" Click="HideToTray_Click"/>
                <Button x:Name="StartAllButton" Style="{StaticResource PrimaryButton}" Content="전체 시작" Click="StartAll_Click"/>
                <Button x:Name="StopAllButton" Style="{StaticResource DangerButton}" Content="전체 중단" Click="StopAll_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="LicenseStatusText" Text="라이선스 확인 중" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="LicenseDetailText" Text="판매자 라이선스 서버와 연결합니다." Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel x:Name="LicenseActivationPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBox x:Name="LicenseKeyBox" Width="290" Margin="0,0,8,0" ToolTip="판매자에게 받은 KM-... 키"/>
                    <Button x:Name="ActivateButton" Style="{StaticResource PrimaryButton}" Content="라이선스 인증" Click="Activate_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="390"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="13">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="카톡방 관리" FontSize="19" FontWeight="Bold"/>
                                <TextBlock x:Name="SelectedCountText" Text="선택 0개" Foreground="{StaticResource Muted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource PrimaryButton}" Content="+ 현재 방 연결" Click="PairCurrent_Click"/>
                        </Grid>
                        <TextBlock x:Name="PairingStatusText" Text="Ctrl+Shift+F8 또는 ‘현재 방 연결’을 사용할 수 있습니다." Foreground="{StaticResource Accent}" Margin="0,9,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="1" Margin="0,11,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="118"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="RoomSearchBox" ToolTip="방 이름 / 상태 검색" TextChanged="RoomSearch_TextChanged"/>
                        <ComboBox x:Name="RoomFilterBox" Grid.Column="1" Margin="6,0,0,0" SelectionChanged="RoomFilterBox_SelectionChanged" ToolTip="방 상태 필터">
                            <ComboBoxItem Content="전체"/>
                            <ComboBoxItem Content="실행 중"/>
                            <ComboBoxItem Content="사용 설정"/>
                            <ComboBoxItem Content="연결 필요"/>
                            <ComboBoxItem Content="확인 필요"/>
                        </ComboBox>
                        <Button Grid.Column="2" Content="전체 선택" Click="SelectAllRooms_Click"/>
                        <Button Grid.Column="3" Content="해제" Click="ClearSelection_Click"/>
                    </Grid>

                    <ListBox x:Name="RoomList" Grid.Row="2" SelectionMode="Extended" SelectionChanged="RoomList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#191D24" BorderBrush="#262D37" BorderThickness="1" Padding="11" CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding ScheduleSummary}" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,3,0,0"/>
                                            <TextBlock Text="{Binding LastStatus}" Foreground="#B7C0CE" FontSize="11" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding TodayCount}" Foreground="{StaticResource Accent}" FontWeight="SemiBold" ToolTip="오늘 전송 횟수" Margin="8,2,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="3" Margin="0,9,0,0">
                        <Button Content="선택 시작" Click="StartSelected_Click"/>
                        <Button Content="선택 중단" Click="StopSelected_Click"/>
                        <Button Content="연결 확인" Click="ValidateSelected_Click"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                        <Button Style="{StaticResource DangerButton}" Content="선택 삭제" Click="RemoveSelected_Click"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                <TabControl>
                    <TabItem Header="개별 설정">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,4,8">
                                <TextBlock Text="선택 방 설정" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="BoundRoomText" Text="방 하나를 선택하면 세부 설정을 편집할 수 있습니다." Foreground="{StaticResource Muted}" Margin="0,5,0,16"/>

                                <TextBlock Text="표시 이름" FontWeight="SemiBold"/>
                                <TextBox x:Name="DisplayNameBox" Margin="0,6,0,12"/>

                                <TextBlock Text="보낼 메시지" FontWeight="SemiBold"/>
                                <TextBox x:Name="MessageEditor" Height="128" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6,0,13"/>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="스케줄 방식" FontWeight="SemiBold"/>
                                        <ComboBox x:Name="ScheduleModeBox" Margin="0,6,0,0" SelectionChanged="ScheduleModeBox_SelectionChanged">
                                            <ComboBoxItem Content="간격 반복"/>
                                            <ComboBoxItem Content="지정 시각"/>
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="하루 최대 전송 (0=무제한)" FontWeight="SemiBold"/>
                                        <TextBox x:Name="DailyLimitBox" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Grid>

                                <StackPanel x:Name="IntervalPanel" Margin="0,0,0,12">
                                    <TextBlock Text="반복 간격 (분)" FontWeight="SemiBold"/>
                                    <TextBox x:Name="IntervalBox" Margin="0,6,0,0"/>
                                </StackPanel>
                                <StackPanel x:Name="TimesPanel" Margin="0,0,0,12" Visibility="Collapsed">
                                    <TextBlock Text="매일 전송 시각 · 예: 09:00, 13:30, 21:00" FontWeight="SemiBold"/>
                                    <TextBox x:Name="TimesBox" Margin="0,6,0,0"/>
                                </StackPanel>

                                <CheckBox x:Name="EnabledCheck" Content="이 방 자동전송 사용" IsChecked="True" Margin="0,2,0,13"/>

                                <Border Background="#231F0E" BorderBrush="#5A500A" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="사진 전송 안전 잠금" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/>
                                        <TextBlock Text="실제 PC 카카오 첨부 흐름을 검증하기 전에는 사진 설정이 있는 방을 텍스트만 보내지 않고 안전하게 차단합니다." Foreground="#D6CA87" Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="SaveRoomButton" Content="설정 저장" Click="SaveRoom_Click"/>
                                    <Button x:Name="TestSendButton" Style="{StaticResource PrimaryButton}" Content="1회 테스트 전송" Click="TestSend_Click"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="일괄 편집">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,0,4,8">
                                <TextBlock Text="선택한 방 일괄 편집" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="BulkSelectedText" Text="왼쪽에서 여러 방을 선택하세요." Foreground="{StaticResource Muted}" Margin="0,5,0,15"/>

                                <Border Background="#101319" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ApplyMessageCheck" Content="메시지 일괄 적용" FontWeight="SemiBold"/>
                                        <TextBox x:Name="BulkMessageEditor" Height="92" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#101319" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,10">
                                    <StackPanel>
                                        <CheckBox x:Name="ApplyScheduleCheck" Content="스케줄 일괄 적용" FontWeight="SemiBold"/>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <ComboBox x:Name="BulkScheduleModeBox" SelectedIndex="0">
                                                <ComboBoxItem Content="간격 반복"/>
                                                <ComboBoxItem Content="지정 시각"/>
                                            </ComboBox>
                                            <TextBox x:Name="BulkIntervalBox" Grid.Column="2" Text="60" ToolTip="간격 반복일 때 분 단위"/>
                                        </Grid>
                                        <TextBox x:Name="BulkTimesBox" Text="09:00" Margin="0,8,0,0" ToolTip="지정 시각일 때 예: 09:00, 13:30"/>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Border Background="#101319" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="12">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyDailyLimitCheck" Content="하루 최대 전송 일괄 적용" FontWeight="SemiBold"/>
                                            <TextBox x:Name="BulkDailyLimitBox" Text="8" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Background="#101319" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9" Padding="12">
                                        <StackPanel>
                                            <CheckBox x:Name="ApplyEnabledCheck" Content="사용 여부 일괄 적용" FontWeight="SemiBold"/>
                                            <CheckBox x:Name="BulkEnabledCheck" Content="자동전송 사용" IsChecked="True" Margin="0,10,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </Grid>

                                <WrapPanel HorizontalAlignment="Right">
                                    <Button Content="첫 선택 방 설정 복사" Click="CopyPrimaryToSelected_Click"/>
                                    <Button x:Name="UndoBulkButton" Content="마지막 일괄 변경 되돌리기" Click="UndoBulk_Click" IsEnabled="False"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="체크한 항목 일괄 적용" Click="ApplyBulk_Click"/>
                                </WrapPanel>
                                <Separator Margin="0,12" Background="{StaticResource Border}"/>
                                <TextBlock Text="빠른 작업" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <WrapPanel>
                                    <Button Content="선택 사용 켜기" Click="EnableSelected_Click"/>
                                    <Button Content="선택 사용 끄기" Click="DisableSelected_Click"/>
                                    <Button Content="선택 시작" Click="StartSelected_Click"/>
                                    <Button Content="선택 중단" Click="StopSelected_Click"/>
                                    <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="선택 1회 전송" Click="SendSelectedNow_Click"/>
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="운영 / 진단">
                        <Grid Margin="2,0,4,4">
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock Text="운영 상태" FontSize="21" FontWeight="Bold"/>
                                <TextBlock x:Name="RuntimeStatusText" Text="대기 중" Foreground="{StaticResource Muted}" Margin="0,5,0,10"/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Margin="0,0,0,9">
                                <Button Content="선택 연결 확인" Click="ValidateSelected_Click"/>
                                <Button Content="설정 폴더 열기" Click="OpenSettingsFolder_Click"/>
                                <Button Content="로그 지우기" Click="ClearLog_Click"/>
                            </WrapPanel>
                            <TextBox x:Name="LogBox" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12" Background="#0E1116"/>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>
    </Grid>
</Window>