<Window x:Class="VoiceRoomManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보이스룸 매니저 Windows" Height="760" Width="1120"
        MinHeight="660" MinWidth="940" WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}" Foreground="White" FontFamily="Segoe UI">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="보이스룸 매니저 · Windows" FontSize="30" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="공식 Windows 카카오톡 계정을 그대로 사용 · 모바일 앱과 별도 프로그램 · Windows UI Automation 기반"
                           Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="#151922" BorderBrush="{StaticResource Border}" BorderThickness="1"
                    CornerRadius="10" Padding="12,7" VerticalAlignment="Top">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource Good}" VerticalAlignment="Center"/>
                    <TextBlock Text="Windows v0.1.x" Margin="7,0,0,0" Foreground="#C8D0DB" FontSize="12"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="16" Padding="20" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MasterStatus" Text="● 보이스룸 자동관리 중지됨" FontSize="22" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="SystemStatus" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <TextBlock Text="모니터 OFF는 가능 · Windows 잠금/로그아웃 상태에서는 안전하게 대기"
                               Foreground="{StaticResource Warn}" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="전체 시작" Click="StartAll_Click" Background="#2C895B"/>
                    <Button Content="전체 중단" Click="StopAll_Click" Background="#9A434C"/>
                    <Button Content="카카오톡 열기" Click="OpenKakao_Click" Background="#40506F"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,22,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="관리할 오픈채팅방" FontSize="21" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="방을 선택한 뒤 안전 점검 → 실제 점검 순서로 최초 등록을 완료해."
                           Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#151922" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="9"
                        Padding="10,7" Margin="0,0,10,0">
                    <CheckBox x:Name="RunAtLoginCheck" Content="Windows 로그인 시 자동 실행"
                              Checked="RunAtLogin_Changed" Unchecked="RunAtLogin_Changed"/>
                </Border>
                <Button Content="＋ 방 추가" Click="AddRoom_Click" Background="{StaticResource Accent}" MinWidth="110"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="16" Padding="10">
            <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" CanUserAddRows="False"
                      SelectionMode="Single" SelectionUnit="FullRow" IsReadOnly="True"
                      AlternationCount="2" RowHeaderWidth="0" ColumnHeaderHeight="38"
                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="방 이름" Binding="{Binding Title}" Width="1.7*"/>
                    <DataGridCheckBoxColumn Header="관리" Binding="{Binding Enabled}" Width="70"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding StatusDisplay}" Width="160"/>
                    <DataGridTextColumn Header="남은 시간" Binding="{Binding Remaining}" Width="145"/>
                    <DataGridCheckBoxColumn Header="실제 활성" Binding="{Binding LiveVerified}" Width="85"/>
                    <DataGridCheckBoxColumn Header="마이크" Binding="{Binding MicMuted}" Width="72"/>
                    <DataGridCheckBoxColumn Header="스피커" Binding="{Binding SpeakerMuted}" Width="72"/>
                    <DataGridTextColumn Header="최근 동작 / 오류" Binding="{Binding OperationDetail}" Width="2.5*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="관리 ON / OFF" Click="ToggleRoom_Click"/>
                <Button Content="안전 점검" Click="SafeProbe_Click" Background="#53698F"/>
                <Button Content="실제 점검" Click="LiveCheck_Click" Background="#4167AE"/>
                <Button Content="방 삭제" Click="RemoveRoom_Click" Background="#70434B"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" MaxWidth="520">
                <TextBlock x:Name="RuntimeStats" HorizontalAlignment="Right" Foreground="#C5CCD6" FontSize="12" TextWrapping="Wrap"/>
                <TextBlock x:Name="LastStatus" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"
                           Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" TextAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="5" Background="#11151C" BorderBrush="{StaticResource Border}" BorderThickness="1"
                CornerRadius="10" Padding="12,9" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="초기 설정" Foreground="{StaticResource Warn}" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Margin="12,0,0,0" Foreground="{StaticResource Muted}" FontSize="12"
                           Text="1) 방 추가  →  2) 안전 점검  →  3) 실제 점검  →  4) 관리 ON  →  5) 전체 시작"/>
            </Grid>
        </Border>
    </Grid>
</Window>
