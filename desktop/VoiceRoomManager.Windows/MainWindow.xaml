<Window x:Class="VoiceRoomManager.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="VoiceRoom Manager" Width="1180" Height="860" MinWidth="840" MinHeight="640" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Bg}" Foreground="White" FontFamily="Segoe UI">
 <ScrollViewer Background="{StaticResource Bg}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
 <Grid Margin="28">
 <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <StackPanel><TextBlock Text="VOICE ROOM" Foreground="{StaticResource Good}" FontWeight="Bold" FontSize="12"/>
   <TextBlock Text="조용하게, 계속 연결되도록" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,0"/>
   <TextBlock Text="방을 등록하고 전체 시작을 누르세요. 진행과 보호 상태를 여기서 확인할 수 있습니다." Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
  </StackPanel><TextBlock x:Name="VersionBadge" Grid.Column="1" Foreground="{StaticResource Muted}" VerticalAlignment="Top"/>
 </Grid>
 <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="18" Padding="22" Margin="0,24,0,0" BorderBrush="{StaticResource Border}" BorderThickness="1">
  <StackPanel><TextBlock x:Name="MasterStatus" FontSize="21" FontWeight="SemiBold"/>
   <TextBlock x:Name="SystemStatus" Foreground="{StaticResource Muted}" Margin="0,9,0,0" TextWrapping="Wrap"/>
   <WrapPanel Margin="-4,16,0,0"><Button x:Name="StartButton" Content="▶  전체 시작" Click="StartAll_Click" Background="{StaticResource Accent}" MinWidth="148"/>
   <Button x:Name="RecheckAllButton" Content="전체 다시 점검" Click="RecheckAll_Click" Background="{StaticResource Surface}"/><Button Content="전체 중단" Click="StopAll_Click" Background="{StaticResource Surface}"/>
   <TextBlock Text="다른 작업 중 창 전환 없이 대기 · 매니저/해당 방에서 재개" Foreground="{StaticResource Muted}" Margin="16,0,0,0" VerticalAlignment="Center"/>
   </WrapPanel>
  </StackPanel>
 </Border>
 <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="14" Padding="18" Margin="0,16,0,0">
 <StackPanel><TextBlock Text="01  방 등록" FontWeight="SemiBold" FontSize="16"/>
 <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="3*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
 <StackPanel Margin="0,0,12,0"><TextBlock Text="Kakao에 표시되는 정확한 방 이름" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="RoomNameInput" MaxLength="100"/></StackPanel>
 <StackPanel Grid.Column="1" Margin="0,0,12,0"><TextBlock Text="OpenChat 링크 · https://open.kakao.com/o/..." Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,6"/><TextBox x:Name="RoomLinkInput"/></StackPanel>
 <Button Grid.Column="2" Content="＋ 방 추가" Click="AddRoom_Click" VerticalAlignment="Bottom" Background="{StaticResource Surface}"/>
 </Grid><TextBlock x:Name="FormError" Foreground="{StaticResource Warn}" Margin="0,8,0,0" TextWrapping="Wrap"/>
 <TextBlock Text="같은 Kakao 클라이언트에서 다른 보이스룸 생성 시 기존 참여 종료를 요구하면, 현재 방을 유지하고 다른 방은 대기합니다." Foreground="{StaticResource Muted}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
 </StackPanel></Border>
 <StackPanel Grid.Row="3" Margin="0,24,0,0">
 <Grid><TextBlock Text="02  관리 현황" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="RoomSummary" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/></Grid>
 <Border Background="{StaticResource Card}" CornerRadius="14" Padding="8" Margin="0,12,0,0">
 <Grid><DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" MinHeight="170" MaxHeight="420" RowHeaderWidth="0" ColumnHeaderHeight="40" AlternationCount="2" SelectionChanged="RoomsGrid_SelectionChanged">
 <DataGrid.Columns>
 <DataGridTemplateColumn Header="방 / 관리" Width="1.15*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Text="{Binding ManagementDisplay}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTemplateColumn Header="진행 상태" Width="1.5*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="10,8"><TextBlock Text="{Binding StatusDisplay}" FontWeight="SemiBold"/><TextBlock Text="{Binding Stage}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,5,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
 <DataGridTextColumn Header="남은 시간" Binding="{Binding Remaining}" Width="1.1*"/>
 <DataGridTextColumn Header="다음 점검" Binding="{Binding NextCheckDisplay}" Width="1.05*"/>
 <DataGridTextColumn Header="최근 성공" Binding="{Binding LastSuccessDisplay}" Width="1*"/>
 </DataGrid.Columns></DataGrid>
 <Border x:Name="EmptyState" Background="{StaticResource Card}" Padding="26" IsHitTestVisible="False"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><TextBlock Text="첫 방을 등록해 보세요" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="방 이름 + 링크 등록 → 전체 시작 → 활성과 오디오 보호 확인" Foreground="{StaticResource Muted}" Margin="0,12,0,0"/></StackPanel></Border>
 </Grid></Border>
 <WrapPanel Margin="-4,8,0,0"><Button x:Name="ToggleButton" Content="선택 방 관리 대상 ON / OFF" Click="ToggleRoom_Click" Background="{StaticResource Surface}"/><Button x:Name="CheckButton" Content="선택 방 지금 확인" Click="LiveCheck_Click" Background="{StaticResource Surface}"/><Button x:Name="RemoveButton" Content="등록 삭제" Click="RemoveRoom_Click" Background="{StaticResource Surface}"/></WrapPanel>
 <Border Background="{StaticResource Card}" CornerRadius="10" Padding="14" Margin="0,10,0,0"><StackPanel><TextBlock x:Name="SelectedStatus" Text="방을 선택하면 보호 상태와 필요한 조치를 확인할 수 있습니다." TextWrapping="Wrap"/><TextBlock x:Name="SelectedError" Foreground="{StaticResource Warn}" Margin="0,6,0,0" TextWrapping="Wrap"/><Button x:Name="ClearCreationButton" Content="Kakao에서 종료 확인 · 생성 대기 해제" Click="ClearCreation_Click" HorizontalAlignment="Left" Margin="0,10,0,0" Visibility="Collapsed"/></StackPanel></Border>
 </StackPanel>
 <Expander Grid.Row="4" Header="고급 진단 · 호환성 설정" Foreground="{StaticResource Muted}" Margin="0,18,0,0">
 <Border Background="{StaticResource Card}" CornerRadius="12" Padding="16" Margin="0,10,0,0"><StackPanel>
 <WrapPanel><CheckBox x:Name="RunAtLoginCheck" Content="Windows 로그인 시 실행" Checked="RunAtLogin_Changed" Unchecked="RunAtLogin_Changed" Margin="0,0,20,0"/><Button Content="카카오톡 열기" Click="OpenKakao_Click"/><Button Content="안전 진단" Click="SafeProbe_Click"/><Button Content="진단 내보내기" Click="ExportDiagnostics_Click"/><Button Content="방 설정 백업" Click="ExportRooms_Click"/><Button Content="방 설정 복원" Click="ImportRooms_Click"/></WrapPanel>
 <TextBlock x:Name="RuntimeStats" Foreground="{StaticResource Muted}" Margin="0,10,0,0" TextWrapping="Wrap"/>
 <TextBlock Text="요청 처리는 명시적 거절/차단 컨트롤을 확인할 때만 실행합니다. 다른 계정의 실제 요청 검증은 별도로 필요합니다." Foreground="{StaticResource Muted}" Margin="0,6,0,0" TextWrapping="Wrap"/>
 <TextBox x:Name="LastStatus" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="100" VerticalScrollBarVisibility="Auto" Margin="0,10,0,0"/>
 <TextBlock Text="기본 메뉴는 자동 인식합니다. 아래 호환성 지점은 지원하지 않는 버전에서만 선택적으로 사용하세요." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,16,0,8"/>
 <WrapPanel><ComboBox x:Name="CalibrationTarget" SelectedIndex="0" Width="240"><ComboBoxItem Content="보이스룸 메뉴" Tag="voice_menu"/><ComboBoxItem Content="저장한 호환성 설정 초기화" Tag="clear"/></ComboBox><Button Content="호환성 지점 등록" Click="Calibrate_Click"/></WrapPanel>
 </StackPanel></Border></Expander>
 <TextBlock Grid.Row="5" Text="독립 유틸리티 · Kakao 공식 제품이 아닙니다. 로그인과 보안 확인은 사용자가 직접 완료해 주세요." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,22,0,0" TextWrapping="Wrap"/>
 </Grid></ScrollViewer>
</Window>
