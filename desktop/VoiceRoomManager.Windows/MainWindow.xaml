<Window x:Class="VoiceRoomManager.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="보이스룸 매니저 Windows" Height="760" Width="1080"
        MinHeight="620" MinWidth="900" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="보이스룸 매니저 · Windows" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="공식 Windows 카카오톡 계정을 그대로 사용 · 모바일 앱과 별도 프로그램 · 좌표 매크로 대신 Windows UI Automation 사용"
                       Foreground="{StaticResource Muted}" FontSize="13" Margin="0,6,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="18" Padding="18" Margin="0,18,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="MasterStatus" Text="● 자동관리 중지됨" FontSize="22" FontWeight="Bold"/>
                    <TextBlock x:Name="SystemStatus" Foreground="{StaticResource Muted}" Margin="0,8,0,0"/>
                    <TextBlock Text="모니터는 꺼도 돼. 단, Windows 로그인 세션이 잠기면 UI Automation은 안전하게 대기해."
                               Foreground="{StaticResource Warn}" Margin="0,8,0,0" FontSize="12"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="전체 시작" Click="StartAll_Click" Background="#2B8457"/>
                    <Button Content="전체 중단" Click="StopAll_Click" Background="#913B43"/>
                    <Button Content="카카오톡 열기" Click="OpenKakao_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="관리할 오픈채팅방" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="RunAtLoginCheck" Content="Windows 시작 시 자동 실행" VerticalAlignment="Center" Margin="0,0,12,0" Checked="RunAtLogin_Changed" Unchecked="RunAtLogin_Changed"/>
                <Button Content="＋ 방 추가" Click="AddRoom_Click" Background="#375EA4"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="3" Background="{StaticResource Card}" CornerRadius="18" Padding="10">
            <DataGrid x:Name="RoomsGrid" AutoGenerateColumns="False" HeadersVisibility="Column" CanUserAddRows="False"
                      Background="#1C1F26" Foreground="White" RowBackground="#1C1F26" AlternatingRowBackground="#20242C"
                      BorderThickness="0" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#343943"
                      SelectionMode="Single" IsReadOnly="True">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="방" Binding="{Binding Title}" Width="2*"/>
                    <DataGridCheckBoxColumn Header="관리" Binding="{Binding Enabled}" Width="70"/>
                    <DataGridTextColumn Header="상태" Binding="{Binding Status}" Width="130"/>
                    <DataGridTextColumn Header="남은 시간" Binding="{Binding Remaining}" Width="130"/>
                    <DataGridCheckBoxColumn Header="실제 활성" Binding="{Binding LiveVerified}" Width="80"/>
                    <DataGridCheckBoxColumn Header="마이크" Binding="{Binding MicMuted}" Width="70"/>
                    <DataGridCheckBoxColumn Header="스피커" Binding="{Binding SpeakerMuted}" Width="70"/>
                    <DataGridTextColumn Header="오류/진단" Binding="{Binding LastError}" Width="3*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="관리 ON/OFF" Click="ToggleRoom_Click"/>
                <Button Content="안전 점검" Click="SafeProbe_Click" Background="#495B7E"/>
                <Button Content="실제 점검" Click="LiveCheck_Click" Background="#3A5B97"/>
                <Button Content="방 삭제" Click="RemoveRoom_Click" Background="#603A42"/>
            </StackPanel>
            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock x:Name="RuntimeStats" HorizontalAlignment="Right" Foreground="{StaticResource Muted}"/>
                <TextBlock x:Name="LastStatus" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
